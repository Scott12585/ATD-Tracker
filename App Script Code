/***************************************************************
 * CB VULNERABILITY
 *
 * 0 = excellent coverage
 * 100 = highly vulnerable
 ***************************************************************/

/***************************************************************
 * COVERAGE RELIABILITY
 *
 * Uses both targets and coverage routes.
 *
 * Rough interpretation:
 *
 *  5 targets  = low confidence
 * 10 targets  = moderate
 * 15 targets  = good
 * 20+ targets = high
 ***************************************************************/

function calculateCoverageReliability(
  targets,
  routes
) {

  /*
   * Targets are more informative for our
   * specific purpose, so they receive 75%.
   */

  const targetReliability =
    Math.min(
      1,
      targets / 20
    );


  /*
   * 120 routes is treated as a mature sample.
   */

  const routeReliability =
    Math.min(
      1,
      routes / 120
    );


  return (

    targetReliability * 0.75 +

    routeReliability * 0.25
  );
}

/***************************************************************
 * REGRESS SMALL SAMPLES TOWARD NEUTRAL
 ***************************************************************/

function adjustCoverageForReliability(
  rawScore,
  reliability
) {

  const neutral = 50;


  return Math.round(

    neutral * (1 - reliability) +

    rawScore * reliability
  );
}

/***************************************************************
 * POSITION DEFENSE RANK
 ***************************************************************/

function getPositionRank(
  team,
  pos,
  defenses
) {

  const list =
    Object.entries(defenses)
      .map(([name, d]) => {

        let n = 0;

        if (pos === 'WR')
          n = d.wr;

        if (pos === 'TE')
          n = d.te;

        if (pos === 'RB')
          n =
            d.rbRec +
            d.rbRush;

        if (pos === 'QB')
          n = d.qbRush;

        return {
          team: name,
          value: n
        };
      })
      .sort(
        (a, b) =>
          b.value - a.value
      );


  const index =
    list.findIndex(
      x => x.team === team
    );

  return index >= 0 ?
    index + 1 :
    '';
}


/***************************************************************
 * MATCHUP EXPLANATION
 ***************************************************************/

function buildAdvancedReason(
  pos,
  defense,
  posAllowed,
  last3Allowed,
  seasonTD,
  recentTD,
  rzCarries,
  goalLine,
  rzTargets,
  inside10,
  rzShare,
  recentRZ
) {

  const parts = [];


  // Defensive matchup

  if (posAllowed >= 4) {

    parts.push(
      defense +
      ' allowed ' +
      posAllowed +
      ' ' +
      pos +
      ' TDs'
    );
  }


  if (last3Allowed >= 6) {

    parts.push(
      last3Allowed +
      ' TDs allowed last 3'
    );
  }


  // Player production

  if (seasonTD >= 4) {

    parts.push(
      seasonTD +
      ' TDs this season'
    );
  }


  if (recentTD >= 2) {

    parts.push(
      recentTD +
      ' TDs last 3'
    );
  }


  // RB / QB rushing opportunity

  if (goalLine >= 3) {

    parts.push(
      goalLine +
      ' carries inside 5'
    );

  } else if (rzCarries >= 5) {

    parts.push(
      rzCarries +
      ' red-zone carries'
    );
  }


  // WR / TE / RB receiving opportunity

  if (inside10 >= 3) {

    parts.push(
      inside10 +
      ' targets inside 10'
    );

  } else if (rzTargets >= 4) {

    parts.push(
      rzTargets +
      ' red-zone targets'
    );
  }


  // Recent scoring opportunities

  if (recentRZ >= 5) {

    parts.push(
      recentRZ +
      ' RZ opportunities last 3'
    );
  }


  // Team share

  if (rzShare >= 0.30) {

    parts.push(
      Math.round(
        rzShare * 100
      ) +
      '% team RZ share'
    );
  }


  if (!parts.length) {

    parts.push(
      'Above-average TD matchup'
    );
  }


  return parts
    .slice(0, 4)
    .join(' • ');
}

/***************************************************************
 * GAME DATE / TIME DISPLAY
 ***************************************************************/

function formatGameDateTime(dateValue, timeValue) {

  if (!dateValue) return '';

  const tz = 'America/New_York';

  // Format game date
  const date = new Date(dateValue);

  if (isNaN(date.getTime())) {
    return String(dateValue);
  }

  const dateText =
    Utilities.formatDate(
      date,
      tz,
      'EEE M/d'
    );

  // Format game time
  let timeText = '';

  if (timeValue instanceof Date) {

    timeText =
      Utilities.formatDate(
        timeValue,
        tz,
        'h:mm a'
      );

  } else if (timeValue) {

    const raw =
      String(timeValue).trim();

    /*
     * Handles values such as:
     * 16:25
     * 16:25:00
     * 4:25 PM
     */

    const match =
      raw.match(/^(\d{1,2}):(\d{2})(?::\d{2})?$/);

    if (match) {

      let hour = Number(match[1]);
      const minute = match[2];

      const ampm =
        hour >= 12 ? 'PM' : 'AM';

      hour = hour % 12;

      if (hour === 0)
        hour = 12;

      timeText =
        hour +
        ':' +
        minute +
        ' ' +
        ampm;

    } else {

      timeText = raw;
    }
  }

  return timeText
    ? dateText + ' • ' + timeText
    : dateText;
}

/***************************************************************
 * CURRENT WEEK
 ***************************************************************/

function getCurrentWeek() {

  const ss =
    SpreadsheetApp.getActive();

  const settings =
    ss.getSheetByName(
      NFL.SHEETS.SETTINGS
    );

  /*
   * Current Week lives in row 3
   * in the Settings tab we built.
   */

  const manual =
    num(
      settings
        .getRange('B3')
        .getValue()
    );

  if (manual)
    return manual;


  /*
   * fallback
   */

  const schedule =
    ss.getSheetByName(
      NFL.SHEETS.SCHEDULE
    )
      .getDataRange()
      .getValues();

  const h =
    columnMap(schedule[0]);

  const today =
    new Date();

  let closest = 1;
  let distance = Infinity;


  for (
    let i = 1;
    i < schedule.length;
    i++
  ) {

    const d =
      new Date(
        schedule[i][h['Date']]
      );

    if (isNaN(d))
      continue;

    const diff =
      Math.abs(
        d.getTime() -
        today.getTime()
      );

    if (diff < distance) {

      distance = diff;

      closest =
        num(
          schedule[i][h['Week']]
        );
    }
  }

  return closest;
}


