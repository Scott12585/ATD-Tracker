            'Time ET'
          )
        ),

      away_team:
        awayTeam,

      home_team:
        homeTeam,

      game_label:
        game,

      play_rank:
        playRank,

      player:
        player,

      player_team:
        String(
          val(
            row,
            'Team'
          ) || ''
        ),

      opponent:
        String(
          val(
            row,
            'Opponent'
          ) || ''
        ),

      home_away:
        String(
          val(
            row,
            'Team'
          ) || ''
        ) === homeTeam
          ? 'H'
          : 'A',

      play_type:
        String(
          val(
            row,
            'Play Type'
          ) || ''
        ),

      confidence:
        numberOrNull_(
          val(
