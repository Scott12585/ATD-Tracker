function buildDefenseTargetSyncRows_(
  season,
  week
) {

  const ss =
    SpreadsheetApp.getActive();


  const sheet =
    ss.getSheetByName(
      'Defense Rankings'
    );


  if (!sheet) {

    throw new Error(
      'Defense Rankings sheet not found.'
    );
  }


  const data =
    sheet
      .getDataRange()
      .getValues();


  if (data.length < 2) {
    return [];
  }


  // ==========================================================
// FIND ACTUAL HEADER ROW
// ==========================================================

let headerRowIndex = -1;

for (let r = 0; r < Math.min(data.length, 15); r++) {

  const testHeaders =
    data[r].map(
      h => String(h).trim()
    );

  const hasGames =
    testHeaders.includes('Games');

  const hasTotalTD =
    testHeaders.includes('Total TD');

  const hasWR =
    testHeaders.includes('WR Rec TD');

  if (
    hasGames &&
    hasTotalTD &&
    hasWR
  ) {

    headerRowIndex = r;
    break;
  }
}


if (headerRowIndex === -1) {

  throw new Error(
    'Could not locate the Defense Rankings header row.'
  );
}


const headers =
  data[headerRowIndex].map(
    h => String(h).trim()
  );


console.log(
  'Defense Rankings header row: ' +
  (headerRowIndex + 1)
);

console.log(
  'Defense Rankings headers: ' +
  headers.join(' | ')
);


 function col(...names) {

  for (const name of names) {

    const i =
      headers.indexOf(name);

    if (i !== -1) {
      return i;
    }
  }

  throw new Error(
    'Defense Rankings column not found. Tried: ' +
    names.join(', ') +
    '\n\nActual headers: ' +
    headers.join(' | ')
  );
}

  const C = {

    defense:
  col(
    'Defense',
    'Team',
    'Def Team',
    'Defensive Team'
  ),

    games:
      col('Games'),

    totalTD:
      col('Total TD'),

    tdGame:
      col('TD/Game'),

    wr:
      col('WR Rec TD'),

    te:
      col('TE Rec TD'),

    rbRec:
      col('RB Rec TD'),

    rbRush:
      col('RB Rush TD'),

    qbRush:
      col('QB Rush TD'),

    last3:
      col('Last 3 TD'),

    last3Game:
      col('Last 3 / Game'),

    bestAttack:
      col('Best Attack'),

    trend:
      col('Trend')
  };


  const raw = [];


  for (
  let i = headerRowIndex + 1;
  i < data.length;
  i++
) {
    const row =
      data[i];


    const defense =
      String(
        row[C.defense] || ''
      ).trim();


    if (!defense) {
      continue;
    }


    const games =
      Number(
        row[C.games]
      ) || 0;


    const positions = [

      {
        position: 'WR',
        td:
          Number(
            row[C.wr]
          ) || 0
      },

      {
        position: 'TE',
        td:
          Number(
            row[C.te]
          ) || 0
      },

      {
        position: 'RB',
        td:
          (
            Number(
              row[C.rbRec]
            ) || 0
          ) +
          (
            Number(
              row[C.rbRush]
            ) || 0
          )
      },

      {
        position: 'QB',
        td:
          Number(
            row[C.qbRush]
          ) || 0
      }
    ];


    positions.forEach(
      p => {

        raw.push({

          season:
            season,

          week:
            week,

          defense:
            defense,

          position:
            p.position,

          games:
            games,

          total_td:
            p.td,

          td_per_game:
            games
              ? p.td / games
              : 0,

          last3_td:
            Number(
              row[C.last3]
            ) || 0,

          last3_td_per_game:
            Number(
              row[C.last3Game]
            ) || 0,

          trend:
            String(
              row[C.trend] || ''
            ),

          best_attack:
            String(
              row[C.bestAttack] || ''
            )
        });
      }
    );
  }


  // --------------------------------------------------------
  // POSITION-SPECIFIC RANKS
  //
  // Higher TD/Game allowed = worse defense.
  //
  // Target Rank:
  // 1 = BEST defense for us to attack.
  //
  // Defense Rank:
  // 32 = worst NFL defense at stopping position.
  // --------------------------------------------------------

  [
    'WR',
    'TE',
    'RB',
    'QB'
  ].forEach(
    position => {

      const group =
        raw
          .filter(
            r =>
              r.position ===
              position
          )
          .sort(
            (a, b) =>
              b.td_per_game -
              a.td_per_game
          );


      group.forEach(
        (r, index) => {

          r.target_rank =
            index + 1;

          r.defense_rank =
            group.length -
            index;
        }
      );
    }
  );


  return raw;
}


