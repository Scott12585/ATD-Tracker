/***************************************************************
 * FETCH CSV
 ***************************************************************/

function fetchCSV(url) {

  const response = UrlFetchApp.fetch(url, {
    muteHttpExceptions: true,
    followRedirects: true,
    headers: {
      'User-Agent': 'Mozilla/5.0'
    }
  });

  if (response.getResponseCode() !== 200) {
    throw new Error(
      'Could not download:\n' +
      url +
      '\nHTTP ' +
      response.getResponseCode()
    );
  }

  let text;

  if (url.endsWith('.gz')) {

    const blob = response.getBlob();

    const unzipped = Utilities.ungzip(blob);

    text = unzipped.getDataAsString();

  } else {

    text = response.getContentText();
  }

  return Utilities.parseCsv(text);
}


/***************************************************************
 * HELPER — COLUMN LOOKUP
 ***************************************************************/

function columnMap(headers) {

  const map = {};

  headers.forEach((h, i) => {
    map[String(h).trim()] = i;
  });

  return map;
}


function value(row, map, name) {

  const i = map[name];

  if (i === undefined) return '';

  return row[i];
}


function num(v) {

  const n = Number(v);

  return Number.isFinite(n) ? n : 0;
}


/***************************************************************
 * SCHEDULE
 ***************************************************************/

function importSchedule() {

  const data = fetchCSV(NFL.URLS.SCHEDULE);

  const headers = data[0];

  const m = columnMap(headers);

  const output = [[
    'Season',
    'Week',
    'Date',
    'Time ET',
    'Away',
    'Home',
    'Away Opp Defense',
    'Home Opp Defense',
    'Game ID',
    'Status'
  ]];

  for (let i = 1; i < data.length; i++) {

    const r = data[i];

    if (num(value(r, m, 'season')) !== NFL.SEASON)
      continue;

    const gameType =
      value(r, m, 'game_type');

    if (gameType && gameType !== 'REG')
      continue;

    const away =
      value(r, m, 'away_team');

    const home =
      value(r, m, 'home_team');

    output.push([
      NFL.SEASON,
      num(value(r, m, 'week')),
      value(r, m, 'gameday'),
      value(r, m, 'gametime'),
      away,
      home,
      home,
      away,
      value(r, m, 'game_id'),
      value(r, m, 'result') ? 'Final' : 'Scheduled'
    ]);
  }

  writeTable(
    NFL.SHEETS.SCHEDULE,
    output
  );

  /*
   * Keep raw schedule too
   */

  const rawSheet =
    SpreadsheetApp.getActive()
      .getSheetByName(NFL.SHEETS.RAW_SCHEDULE);

  rawSheet.clearContents();

  const rawRows = data.filter((r, i) =>
    i === 0 ||
    num(value(r, m, 'season')) === NFL.SEASON
  );

  if (rawRows.length) {

    rawSheet
      .getRange(
        1,
        1,
        rawRows.length,
        rawRows[0].length
      )
      .setValues(rawRows);
  }
}


/***************************************************************
 * PLAYER STATS
 ***************************************************************/

function importPlayerStats() {

  const data =
    fetchCSV(NFL.URLS.PLAYER_STATS);

  const headers = data[0];

  const m = columnMap(headers);

  const rows = [headers];

  for (let i = 1; i < data.length; i++) {

    const r = data[i];

    if (
      num(value(r, m, 'season')) === NFL.SEASON
    ) {
      rows.push(r);
    }
  }

  const sheet =
    SpreadsheetApp.getActive()
      .getSheetByName(NFL.SHEETS.RAW_PLAYERS);

  sheet.clearContents();

  if (rows.length) {

    ensureSize(
      sheet,
      rows.length,
      rows[0].length
    );

    sheet
      .getRange(
        1,
        1,
        rows.length,
        rows[0].length
      )
      .setValues(rows);
  }
}


/***************************************************************
 * TOUCHDOWN DATABASE
 ***************************************************************/

function importTouchdowns() {

  const pbp = fetchCSV(NFL.URLS.PBP);

  const headers = pbp[0];

  const m = columnMap(headers);

  /*
   * Roster lets us reliably identify
   * RB / WR / TE / QB.
   */

  const positions = loadRosterPositions();

  const output = [[
    'Season',
    'Week',
    'Game ID',
    'Date',
    'Offense',
    'Defense',
    'Scorer',
    'Player ID',
    'Position',
    'TD Type',
    'Passer',
    'Yards',
    'Quarter',
    'Time',
    'Source Play ID'
  ]];

  for (let i = 1; i < pbp.length; i++) {

    const r = pbp[i];

    /*
     * Only actual offensive TD plays.
     */

    if (
      num(value(r, m, 'touchdown')) !== 1
    ) continue;

    /*
     * Ignore defensive and special teams TDs.
     */

    const interceptionTD =
      num(value(r, m, 'interception')) === 1;

    const fumbleReturn =
      num(value(r, m, 'fumble_lost')) === 1 &&
      !value(r, m, 'rusher_player_id') &&
      !value(r, m, 'receiver_player_id');

    const returnTD =
      num(value(r, m, 'return_touchdown')) === 1;

    if (
      interceptionTD ||
      fumbleReturn ||
      returnTD
    ) continue;


    const passer =
      value(r, m, 'passer_player_name');

    const receiver =
      value(r, m, 'receiver_player_name');

    const receiverID =
      value(r, m, 'receiver_player_id');

    const rusher =
      value(r, m, 'rusher_player_name');

    const rusherID =
      value(r, m, 'rusher_player_id');


    let scorer = '';
    let playerID = '';
    let tdType = '';
    let yards = 0;


    /*
     * Receiving TD
     */

    if (
      num(value(r, m, 'pass_touchdown')) === 1
    ) {

      scorer = receiver;
      playerID = receiverID;

      tdType = 'Receiving';

      yards =
        num(value(r, m, 'receiving_yards'));
    }


    /*
     * Rushing TD
     */

    else if (
      num(value(r, m, 'rush_touchdown')) === 1
    ) {

      scorer = rusher;
      playerID = rusherID;

      tdType = 'Rushing';

      yards =
        num(value(r, m, 'rushing_yards'));
    }


    /*
     * We only want offensive rushing/receiving
     * TDs for this model.
     */

    else {
      continue;
    }


    if (!scorer)
      continue;


    let pos =
      positions[playerID] || '';

    /*
     * nflverse occasionally has missing
     * position mappings. Keep UNKNOWN so
     * the TD still counts toward overall.
     */

    if (!pos)
      pos = 'UNK';


    output.push([
      NFL.SEASON,

      num(value(r, m, 'week')),

      value(r, m, 'game_id'),

      value(r, m, 'game_date'),

      value(r, m, 'posteam'),

      value(r, m, 'defteam'),

      scorer,

      playerID,

      normalizePosition(pos),

      tdType,

      passer,

      yards,

      num(value(r, m, 'qtr')),

      value(r, m, 'time'),

      value(r, m, 'play_id')
    ]);
  }


  writeTable(
    NFL.SHEETS.TD_LOG,
    output
  );
}


/***************************************************************
 * ROSTER POSITIONS
 ***************************************************************/

function loadRosterPositions() {

  const data =
    fetchCSV(NFL.URLS.ROSTER);

  const headers = data[0];

  const m = columnMap(headers);

  const map = {};

  for (let i = 1; i < data.length; i++) {

    const r = data[i];

    const id =
      value(r, m, 'gsis_id');

    const pos =
      value(r, m, 'position');

    if (id)
      map[id] = pos;
  }

  return map;
}


function normalizePosition(pos) {

  pos =
    String(pos || '')
      .toUpperCase()
      .trim();

  if (
    ['HB', 'FB'].includes(pos)
  ) return 'RB';

  if (
    ['WR'].includes(pos)
  ) return 'WR';

  if (
    ['TE'].includes(pos)
  ) return 'TE';

  if (
    ['QB'].includes(pos)
  ) return 'QB';

  if (
    ['RB'].includes(pos)
  ) return 'RB';

  return pos || 'UNK';
}


/***************************************************************
 * TEAM GAME LOG
 ***************************************************************/

function buildTeamGameLog() {

  const ss = SpreadsheetApp.getActive();

  const tdSheet =
    ss.getSheetByName(NFL.SHEETS.TD_LOG);

  const rows =
    tdSheet.getDataRange().getValues();

  if (rows.length < 2)
    return;


  const h = columnMap(rows[0]);

  const games = {};


  for (let i = 1; i < rows.length; i++) {

    const r = rows[i];

    const game =
      r[h['Game ID']];

    const defense =
      r[h['Defense']];

    if (!game || !defense)
      continue;


    const key =
      game + '|' + defense;


    if (!games[key]) {

      games[key] = {
        season: r[h['Season']],
        week: r[h['Week']],
        date: r[h['Date']],
        defense,
        opponent: r[h['Offense']],
        total: 0,
        pass: 0,
        rush: 0,
        wr: 0,
        te: 0,
        rbRec: 0,
        rbRush: 0,
        qbRush: 0,
        game
      };
    }


    const g = games[key];

    const pos =
      r[h['Position']];

    const type =
      r[h['TD Type']];


    g.total++;


    if (type === 'Receiving') {

      g.pass++;

      if (pos === 'WR')
        g.wr++;

      if (pos === 'TE')
        g.te++;

      if (pos === 'RB')
        g.rbRec++;
    }


    if (type === 'Rushing') {

      g.rush++;

      if (pos === 'RB')
        g.rbRush++;

      if (pos === 'QB')
        g.qbRush++;
    }
  }


  /*
   * Include games where defense allowed ZERO TDs.
   */

  const schedule =
    ss.getSheetByName(NFL.SHEETS.SCHEDULE)
      .getDataRange()
      .getValues();

  const sh =
    columnMap(schedule[0]);


  for (let i = 1; i < schedule.length; i++) {

    const r = schedule[i];

    if (r[sh['Status']] !== 'Final')
      continue;

    const game =
      r[sh['Game ID']];

    const date =
      r[sh['Date']];

    const week =
      r[sh['Week']];

    const away =
      r[sh['Away']];

    const home =
      r[sh['Home']];


    [
      [away, home],
      [home, away]

    ].forEach(pair => {

      const defense = pair[0];
      const opponent = pair[1];

      const key =
        game + '|' + defense;

      if (!games[key]) {

        games[key] = {
          season: NFL.SEASON,
          week,
          date,
          defense,
          opponent,
          total: 0,
          pass: 0,
          rush: 0,
          wr: 0,
          te: 0,
          rbRec: 0,
          rbRush: 0,
          qbRush: 0,
          game
        };
      }
    });
  }


  const output = [[
    'Season',
    'Week',
    'Date',
    'Defense',
    'Opponent',
    'Total TD Allowed',
    'Pass TD',
    'Rush TD',
    'WR TD',
    'TE TD',
    'RB Rec TD',
    'RB Rush TD',
    'QB Rush TD',
    'Game ID'
  ]];


  Object.values(games)
    .sort((a, b) =>
      a.week - b.week ||
      String(a.defense)
        .localeCompare(String(b.defense))
    )
    .forEach(g => {

      output.push([
        g.season,
        g.week,
        g.date,
        g.defense,
        g.opponent,
        g.total,
        g.pass,
        g.rush,
        g.wr,
        g.te,
        g.rbRec,
        g.rbRush,
        g.qbRush,
        g.game
      ]);
    });


  writeTable(
    NFL.SHEETS.GAME_LOG,
    output
  );
}


/***************************************************************
 * DEFENSE RANKINGS
 ***************************************************************/

function buildDefenseRankings() {

  const ss =
    SpreadsheetApp.getActive();

  const sheet =
    ss.getSheetByName(NFL.SHEETS.DEFENSE);

  const gameSheet =
    ss.getSheetByName(NFL.SHEETS.GAME_LOG);

  const rows =
    gameSheet.getDataRange().getValues();

  if (rows.length < 2)
    return;


  const h =
    columnMap(rows[0]);

  const defenses = {};


  for (let i = 1; i < rows.length; i++) {

    const r = rows[i];

    const team =
      r[h['Defense']];

    if (!team)
      continue;


    if (!defenses[team]) {

      defenses[team] = {
        team,
        games: []
      };
    }


    defenses[team].games.push({
      week: num(r[h['Week']]),
      total: num(r[h['Total TD Allowed']]),
      pass: num(r[h['Pass TD']]),
      rush: num(r[h['Rush TD']]),
      wr: num(r[h['WR TD']]),
      te: num(r[h['TE TD']]),
      rbRec: num(r[h['RB Rec TD']]),
      rbRush: num(r[h['RB Rush TD']]),
      qbRush: num(r[h['QB Rush TD']])
    });
  }


  const result = [];


  Object.values(defenses)
    .forEach(d => {

      d.games.sort(
        (a, b) => a.week - b.week
      );

      const games = d.games;

      const last3 =
        games.slice(-3);

      const sum =
        key =>
          games.reduce(
            (s, g) => s + g[key],
            0
          );

      const last3TD =
        last3.reduce(
          (s, g) => s + g.total,
          0
        );


      const positionTotals = {
        WR: sum('wr'),
        TE: sum('te'),
        RB:
          sum('rbRec') +
          sum('rbRush'),
        QB: sum('qbRush')
      };


      const bestAttack =
        Object.entries(positionTotals)
          .sort((a, b) => b[1] - a[1])[0];


      const total =
        sum('total');


      result.push({
        team: d.team,
        games: games.length,
        total,
        perGame:
          games.length ?
            total / games.length :
            0,
        pass: sum('pass'),
        rush: sum('rush'),
        wr: sum('wr'),
        te: sum('te'),
        rbRec: sum('rbRec'),
        rbRush: sum('rbRush'),
        qbRush: sum('qbRush'),
        last3: last3TD,
        last3pg:
          last3.length ?
            last3TD / last3.length :
            0,
        best:
          bestAttack ?
            bestAttack[0] :
            '',
        trend:
          getTrend(
            games,
            last3TD,
            last3.length
          )
      });
    });


  /*
   * Most TD-friendly defense = rank #1
   */

  result.sort(
    (a, b) =>
      b.perGame - a.perGame
  );


  const output = [];


  result.forEach((d, i) => {

    output.push([
      i + 1,
      d.team,
      d.games,
      d.total,
      d.perGame,
      d.pass,
      d.rush,
      d.wr,
      d.te,
      d.rbRec,
      d.rbRush,
      d.qbRush,
      d.last3,
      d.last3pg,
      d.best,
      d.trend
    ]);
  });


  /*
   * Keep title rows 1–3.
   */

  if (
    sheet.getMaxRows() > 3
  ) {

    sheet
      .getRange(
        4,
        1,
        sheet.getMaxRows() - 3,
        16
      )
      .clearContent();
  }


  if (output.length) {

    sheet
      .getRange(
        4,
        1,
        output.length,
        16
      )
      .setValues(output);


    sheet
      .getRange(
        4,
        5,
        output.length,
        1
      )
      .setNumberFormat('0.00');


    sheet
      .getRange(
        4,
        14,
        output.length,
        1
      )
      .setNumberFormat('0.00');
  }


  applyDefenseHeatmap(
    sheet,
    output.length
  );
}


function getTrend(
  games,
  last3TD,
  last3Count
) {

  if (
    !games.length ||
    !last3Count
  ) return '—';


  const season =
    games.reduce(
      (s, g) => s + g.total,
      0
    ) / games.length;


  const recent =
    last3TD / last3Count;


  if (recent >= season + 0.5)
    return '🔥 Worse';

  if (recent <= season - 0.5)
    return '❄️ Better';

  return '➡️ Steady';
}


/***************************************************************
 * PLAYER DATABASE
 ***************************************************************/

function buildPlayers() {

  const ss = SpreadsheetApp.getActive();

  const raw = ss
    .getSheetByName(NFL.SHEETS.RAW_PLAYERS)
    .getDataRange()
    .getValues();

  if (raw.length < 2) return;

  const h = columnMap(raw[0]);
  const players = {};
  // Current roster data is our authority
// for team assignment and roster status.

const currentRoster =
  getCurrentRosterMap();

  // ==========================================================
  // 1. BUILD BASIC PLAYER STATS
  // ==========================================================

  for (let i = 1; i < raw.length; i++) {

    const r = raw[i];

    const id = getAny(r, h, [
      'player_id',
      'gsis_id'
    ]);

    const name = getAny(r, h, [
      'player_display_name',
      'player_name',
      'player'
    ]);

    if (!id || !name) continue;

    const pos = normalizePosition(
      getAny(r, h, [
        'position',
        'position_group'
      ])
    );

    if (!['QB', 'RB', 'WR', 'TE'].includes(pos))
      continue;

    const week = num(
      getAny(r, h, ['week'])
    );

    const rushTD = num(
      getAny(r, h, ['rushing_tds'])
    );

    const recTD = num(
      getAny(r, h, ['receiving_tds'])
    );

    if (!players[id]) {

      players[id] = {
        id,
        name,
        team: '',
        pos,
        weeks: [],
        rzCarries: 0,
        goalLineCarries: 0,
        rzTargets: 0,
        inside10Targets: 0,
        last3RZOpps: 0
      };
    }

    players[id].team =
      getAny(r, h, [
        'recent_team',
        'team'
      ]) || players[id].team;

    players[id].weeks.push({
      week,
      td: rushTD + recTD,
      rushTD,
      recTD
    });
  }


  // ==========================================================
  // 2. DOWNLOAD PBP FOR TRUE RED-ZONE USAGE
  // ==========================================================

  const pbp = fetchCSV(NFL.URLS.PBP);

  if (pbp.length > 1) {

    const pbh = columnMap(pbp[0]);

    // Determine the latest completed/available week
    let maxWeek = 0;

    for (let i = 1; i < pbp.length; i++) {

      const w = num(
        value(pbp[i], pbh, 'week')
      );

      if (w > maxWeek)
        maxWeek = w;
    }

    const last3Start =
      Math.max(1, maxWeek - 2);


    for (let i = 1; i < pbp.length; i++) {

      const r = pbp[i];

      const week =
        num(value(r, pbh, 'week'));

      const yardline =
        num(
          value(
            r,
            pbh,
            'yardline_100'
          )
        );

      /*
       * yardline_100:
       *
       * 20 = opponent 20
       * 10 = opponent 10
       * 5  = opponent 5
       * 1  = opponent 1
       */

      if (!yardline || yardline > 20)
        continue;


      // ======================================================
      // RUSHING ATTEMPTS
      // ======================================================

      const rushAttempt =
        num(
          value(
            r,
            pbh,
            'rush_attempt'
          )
        ) === 1;

      if (rushAttempt) {

        const id =
          value(
            r,
            pbh,
            'rusher_player_id'
          );

        if (id && players[id]) {

          players[id].rzCarries++;

          if (yardline <= 5)
            players[id].goalLineCarries++;

          if (week >= last3Start)
            players[id].last3RZOpps++;
        }
      }


      // ======================================================
      // RECEIVING TARGETS
      // ======================================================

      const passAttempt =
        num(
          value(
            r,
            pbh,
            'pass_attempt'
          )
        ) === 1;

      const receiverID =
        value(
          r,
          pbh,
          'receiver_player_id'
        );

      /*
       * receiver_player_id on an actual pass attempt
       * gives us the intended receiver.
       */

      if (
        passAttempt &&
        receiverID &&
        players[receiverID]
      ) {

        players[receiverID].rzTargets++;

        if (yardline <= 10)
          players[receiverID].inside10Targets++;

        if (week >= last3Start)
          players[receiverID].last3RZOpps++;
      }
    }
  }


  // ==========================================================
  // 3. CALCULATE TEAM RED-ZONE OPPORTUNITY TOTALS
  // ==========================================================

  const teamTotals = {};

  Object.values(players).forEach(p => {

    if (!p.team) return;

    if (!teamTotals[p.team])
      teamTotals[p.team] = 0;

    teamTotals[p.team] +=
      p.rzCarries +
      p.rzTargets;
  });


  // ==========================================================
  // 4. OUTPUT PLAYER DATABASE
  // ==========================================================
  // ==========================================================
// APPLY CURRENT ROSTER DATA
// ==========================================================

Object.values(players).forEach(p => {

  const roster =
    currentRoster[p.id];


  /*
   * No current roster record:
   * do not consider this player active.
   */

  if (!roster) {

    p.active = false;

    return;
  }


  /*
   * Current roster team overrides
   * the potentially stale stats team.
   */

  if (roster.team) {

    p.team =
      roster.team;
  }


  /*
   * Also refresh position when available.
   */

  if (roster.position) {

    p.pos =
      roster.position;
  }


  p.active =
    roster.active;
});


  const output = [[


    'Player ID',
    'Player',
    'Team',
    'Position',
    'Season TDs',
    'Last 3 TDs',
    'RZ Carries',
    'Goal Line Carries',
    'RZ Targets',
    'Inside 10 Targets',
    'RZ Opportunities',
    'Team RZ Share',
    'Last 3 RZ Opps',
    'Opportunity Score',
    'Active'
  ]];


  Object.values(players)
    .forEach(p => {

      p.weeks.sort(
        (a, b) => a.week - b.week
      );

      const seasonTD =
        p.weeks.reduce(
          (s, w) => s + w.td,
          0
        );

      const last3TD =
        p.weeks
          .slice(-3)
          .reduce(
            (s, w) => s + w.td,
            0
          );

      const rzOpps =
        p.rzCarries +
        p.rzTargets;

      const teamTotal =
        teamTotals[p.team] || 0;

      const share =
        teamTotal
          ? rzOpps / teamTotal
          : 0;


      /*
       * OPPORTUNITY SCORE
       *
       * Goal-line carries carry the most weight.
       * Inside-10 targets also receive extra weight.
       *
       * The purpose is not to predict TDs by itself.
       * It measures how much high-value scoring work
       * a player is receiving.
       */

      const opportunityScore =
        Math.min(
          100,
          Math.round(

            p.rzCarries * 2 +

            p.goalLineCarries * 5 +

            p.rzTargets * 2 +

            p.inside10Targets * 3 +

            p.last3RZOpps * 3 +

            share * 30
          )
        );


      output.push([
        p.id,
        p.name,
        p.team,
        p.pos,
        seasonTD,
        last3TD,
        p.rzCarries,
        p.goalLineCarries,
        p.rzTargets,
        p.inside10Targets,
        rzOpps,
        share,
        p.last3RZOpps,
        opportunityScore,
        p.active ? 'Yes' : 'No'
      ]);
    });


  writeTable(
    NFL.SHEETS.PLAYERS,
    output
  );


  /*
   * Format Team RZ Share as %
   */

  const sheet =
    ss.getSheetByName(
      NFL.SHEETS.PLAYERS
    );

  if (output.length > 1) {

    sheet
      .getRange(
        2,
        12,
        output.length - 1,
        1
      )
      .setNumberFormat('0.0%');
  }
}


/***************************************************************
 * WEEKLY TD TARGETS
 ***************************************************************/

function buildWeeklyTDTargets() {

  const ss =
    SpreadsheetApp.getActive();

  const week =
    getCurrentWeek();

  const targetSheet =
    ss.getSheetByName(
      NFL.SHEETS.TARGETS
    );

  const positionFilter =
    String(
      targetSheet
        .getRange('D2')
        .getValue() || 'ALL'
    ).toUpperCase();

  const minimumScore =
    num(
      targetSheet
        .getRange('F2')
        .getValue()
    );


  // ==========================================================
  // DEFENSES
  // ==========================================================

  const defSheet =
    ss.getSheetByName(
      NFL.SHEETS.DEFENSE
    );

  const defRows =
    defSheet
      .getRange(
        3,
        1,
        Math.max(
          1,
          defSheet.getLastRow() - 2
        ),
        16
      )
      .getValues();

  const dh =
    columnMap(defRows[0]);

  const defenses = {};


  for (
    let i = 1;
    i < defRows.length;
    i++
  ) {

    const r = defRows[i];

    const team =
      r[dh['Defense']];

    if (!team)
      continue;


    defenses[team] = {

      rank:
        num(r[dh['Rank']]),

      games:
        num(r[dh['Games']]),

      total:
        num(r[dh['Total TD']]),

      pg:
        num(r[dh['TD/Game']]),

      wr:
        num(r[dh['WR Rec TD']]),

      te:
        num(r[dh['TE Rec TD']]),

      rbRec:
        num(r[dh['RB Rec TD']]),

      rbRush:
        num(r[dh['RB Rush TD']]),

      qbRush:
        num(r[dh['QB Rush TD']]),

      last3:
        num(r[dh['Last 3 TD']])
    };
  }


  // ==========================================================
  // SCHEDULE
  // ==========================================================

  const schedule =
    ss.getSheetByName(
      NFL.SHEETS.SCHEDULE
    )
      .getDataRange()
      .getValues();

  const sh =
    columnMap(schedule[0]);

  const opponents = {};


  for (
    let i = 1;
    i < schedule.length;
    i++
  ) {

    const r = schedule[i];

    if (
      num(r[sh['Week']]) !== week
    ) continue;


    const away =
      r[sh['Away']];

    const home =
      r[sh['Home']];


    const gameDisplay =
      formatGameDateTime(
        r[sh['Date']],
        r[sh['Time ET']]
      );


    opponents[away] = {
      opponent: home,
      game: gameDisplay
    };


    opponents[home] = {
      opponent: away,
      game: gameDisplay
    };
  }


  // ==========================================================
  // PLAYERS
  // ==========================================================

  const playerRows =
    ss.getSheetByName(
      NFL.SHEETS.PLAYERS
    )
      .getDataRange()
      .getValues();

  const ph =
    columnMap(playerRows[0]);

  const candidates = [];


  for (
    let i = 1;
    i < playerRows.length;
    i++
  ) {

    const r = playerRows[i];

    const player =
      r[ph['Player']];

    const pos =
      String(
        r[ph['Position']]
      ).toUpperCase();

    const team =
      r[ph['Team']];

      const active =
  String(
    r[ph['Active']]
  ).toUpperCase() === 'YES';


    if (
  !player ||
  !team ||
  !active ||
  !opponents[team]
) continue;


    if (
      positionFilter !== 'ALL' &&
      pos !== positionFilter
    ) continue;


    const opponent =
      opponents[team].opponent;

    const d =
      defenses[opponent];

    if (!d)
      continue;


    // ========================================================
    // POSITION-SPECIFIC DEFENSE
    // ========================================================

    let posAllowed = 0;


    if (pos === 'WR')
      posAllowed = d.wr;

    else if (pos === 'TE')
      posAllowed = d.te;

    else if (pos === 'RB')
      posAllowed =
        d.rbRec +
        d.rbRush;

    else if (pos === 'QB')
      posAllowed =
        d.qbRush;

    else
      continue;


    // ========================================================
    // PLAYER DATA
    // ========================================================

    const seasonTD =
      num(
        r[ph['Season TDs']]
      );

    const recentTD =
      num(
        r[ph['Last 3 TDs']]
      );

    const rzCarries =
      num(
        r[ph['RZ Carries']]
      );

    const goalLine =
      num(
        r[ph['Goal Line Carries']]
      );

    const rzTargets =
      num(
        r[ph['RZ Targets']]
      );

    const inside10 =
      num(
        r[ph['Inside 10 Targets']]
      );

    const rzShare =
      num(
        r[ph['Team RZ Share']]
      );

    const recentRZ =
      num(
        r[ph['Last 3 RZ Opps']]
      );

    const opportunityScore =
      num(
        r[ph['Opportunity Score']]
      );


    // ========================================================
    // NORMALIZED MODEL COMPONENTS
    // ========================================================

    const positionScore =
      Math.min(
        100,
        posAllowed / 8 * 100
      );


    const recentDefenseScore =
      Math.min(
        100,
        d.last3 / 10 * 100
      );


    const overallDefenseScore =
      Math.min(
        100,
        d.pg / 4 * 100
      );


    const playerSeasonScore =
      Math.min(
        100,
        seasonTD / 8 * 100
      );


    const playerRecentScore =
      Math.min(
        100,
        recentTD / 3 * 100
      );


    // ========================================================
    // FINAL TD MATCHUP SCORE
    // ========================================================
    //
    // 30% Position-specific defense
    // 15% Recent defensive vulnerability
    // 10% Overall defensive TD rate
    // 15% Player season TD production
    // 10% Player recent TD production
    // 20% Actual scoring opportunity
    //
    // ========================================================

    const score =
      Math.round(

        positionScore * 0.30 +

        recentDefenseScore * 0.15 +

        overallDefenseScore * 0.10 +

        playerSeasonScore * 0.15 +

        playerRecentScore * 0.10 +

        opportunityScore * 0.20
      );


    if (
      score < minimumScore
    ) continue;


    candidates.push({

      player,
      pos,
      team,
      opponent,

      game:
        opponents[team].game,

      defRank:
        getPositionRank(
          opponent,
          pos,
          defenses
        ),

      posAllowed,

      last3:
        d.last3,

      seasonTD,

      recentTD,

      opportunityScore,

      score,

      reason:
        buildAdvancedReason(
          pos,
          opponent,
          posAllowed,
          d.last3,
          seasonTD,
          recentTD,
          rzCarries,
          goalLine,
          rzTargets,
          inside10,
          rzShare,
          recentRZ
        )
    });
  }


  // ==========================================================
  // BEST MATCHUPS FIRST
  // ==========================================================

  candidates.sort(
    (a, b) =>
      b.score - a.score
  );


  const output =
    candidates.map(
      (p, i) => [

        i + 1,

        p.player,

        p.pos,

        p.team,

        p.opponent,

        p.game,

        '#' + p.defRank,

        p.posAllowed,

        p.last3,

        p.seasonTD,

        p.recentTD,

        p.opportunityScore,

        p.score,

        p.reason
      ]
    );


  // ==========================================================
  // OUTPUT
  // ==========================================================

  targetSheet
    .getRange('B2')
    .setValue(week);


  targetSheet
    .getRange('L4')
    .setValue(
      'Opportunity Score'
    );


  if (
    targetSheet.getMaxRows() > 4
  ) {

    targetSheet
      .getRange(
        5,
        1,
        targetSheet.getMaxRows() - 4,
        14
      )
      .clearContent();
  }


  if (output.length) {

    ensureSize(
      targetSheet,
      output.length + 4,
      14
    );

    targetSheet
      .getRange(
        5,
        1,
        output.length,
        14
      )
      .setValues(output);
  }


  applyTargetHeatmap(
    targetSheet,
    output.length
  );
}

/***************************************************************
 * GAME-BY-GAME TD TARGETS
 *
 * Takes the best 3 TD candidates from every game.
 *
 * IMPORTANT:
 * Unlike Weekly TD Targets, there is NO minimum-score cutoff.
 * Every game gets analyzed.
 ***************************************************************/

function buildGameByGameTargets() {

  const ss = SpreadsheetApp.getActive();

  const week = getCurrentWeek();

  // ==========================================================
  // CREATE SHEET IF NEEDED
  // ==========================================================

  let sheet =
    ss.getSheetByName(
      NFL.SHEETS.GAME_TARGETS
    );

  if (!sheet) {

    sheet =
      ss.insertSheet(
        NFL.SHEETS.GAME_TARGETS
      );
  }


  // ==========================================================
  // LOAD DEFENSE DATA
  // ==========================================================

  const defSheet =
    ss.getSheetByName(
      NFL.SHEETS.DEFENSE
    );

  const defRows =
    defSheet
      .getRange(
        3,
        1,
        Math.max(
          1,
          defSheet.getLastRow() - 2
        ),
        16
      )
      .getValues();

  const dh =
    columnMap(defRows[0]);

  const defenses = {};


  for (let i = 1; i < defRows.length; i++) {

    const r = defRows[i];

    const team =
      r[dh['Defense']];

    if (!team) continue;


    defenses[team] = {

      rank:
        num(r[dh['Rank']]),

      games:
        num(r[dh['Games']]),

      total:
        num(r[dh['Total TD']]),

      pg:
        num(r[dh['TD/Game']]),

      wr:
        num(r[dh['WR Rec TD']]),

      te:
        num(r[dh['TE Rec TD']]),

      rbRec:
        num(r[dh['RB Rec TD']]),

      rbRush:
        num(r[dh['RB Rush TD']]),

      qbRush:
        num(r[dh['QB Rush TD']]),

      last3:
        num(r[dh['Last 3 TD']])
    };
  }


  // ==========================================================
  // LOAD SCHEDULE
  // ==========================================================

  const schedule =
    ss.getSheetByName(
      NFL.SHEETS.SCHEDULE
    )
      .getDataRange()
      .getValues();

  const sh =
    columnMap(schedule[0]);

  const games = {};


  for (let i = 1; i < schedule.length; i++) {

    const r = schedule[i];

    if (
      num(r[sh['Week']]) !== week
    ) continue;


    const away =
      r[sh['Away']];

    const home =
      r[sh['Home']];

    if (!away || !home)
      continue;


    const gameID =
      r[sh['Game ID']] ||
      away + '_' + home;


    games[gameID] = {

      gameID,

      away,

      home,

      game:
        formatGameDateTime(
          r[sh['Date']],
          r[sh['Time ET']]
        ),

      players: []
    };
  }


  // ==========================================================
  // LOAD PLAYERS
  // ==========================================================

  const playerRows =
    ss.getSheetByName(
      NFL.SHEETS.PLAYERS
    )
      .getDataRange()
      .getValues();

  const ph =
    columnMap(playerRows[0]);


  // ==========================================================
  // SCORE EVERY ELIGIBLE PLAYER
  // ==========================================================

  Object.values(games).forEach(game => {

    for (
      let i = 1;
      i < playerRows.length;
      i++
    ) {

      const r =
        playerRows[i];

      const player =
        r[ph['Player']];

      const team =
  r[ph['Team']];

const pos =
  String(
    r[ph['Position']]
  ).toUpperCase();

const active =
  String(
    r[ph['Active']]
  ).toUpperCase() === 'YES';


      if (
  !player ||
  !team ||
  !active ||
  !['QB', 'RB', 'WR', 'TE']
    .includes(pos)
) {
  continue;
}


      /*
       * Player must belong to one
       * of the teams in this game.
       */

      if (
        team !== game.away &&
        team !== game.home
      ) {
        continue;
      }


      const opponent =
        team === game.away
          ? game.home
          : game.away;


      const d =
        defenses[opponent];

      if (!d)
        continue;


      // ======================================================
      // POSITION-SPECIFIC TD ALLOWANCE
      // ======================================================

      let posAllowed = 0;


      if (pos === 'WR') {

        posAllowed =
          d.wr;

      } else if (pos === 'TE') {

        posAllowed =
          d.te;

      } else if (pos === 'RB') {

        posAllowed =
          d.rbRec +
          d.rbRush;

      } else if (pos === 'QB') {

        posAllowed =
          d.qbRush;
      }


      // ======================================================
      // PLAYER DATA
      // ======================================================

      const seasonTD =
        num(
          r[ph['Season TDs']]
        );

      const recentTD =
        num(
          r[ph['Last 3 TDs']]
        );

      const rzCarries =
        num(
          r[ph['RZ Carries']]
        );

      const goalLine =
        num(
          r[ph['Goal Line Carries']]
        );

      const rzTargets =
        num(
          r[ph['RZ Targets']]
        );

      const inside10 =
        num(
          r[ph['Inside 10 Targets']]
        );

      const rzShare =
        num(
          r[ph['Team RZ Share']]
        );

      const recentRZ =
        num(
          r[ph['Last 3 RZ Opps']]
        );

      const opportunityScore =
        num(
          r[ph['Opportunity Score']]
        );


      // ======================================================
      // SAME MODEL AS WEEKLY TD TARGETS
      // ======================================================

      const positionScore =
        Math.min(
          100,
          posAllowed / 8 * 100
        );


      const recentDefenseScore =
        Math.min(
          100,
          d.last3 / 10 * 100
        );


      const overallDefenseScore =
        Math.min(
          100,
          d.pg / 4 * 100
        );


      const playerSeasonScore =
        Math.min(
          100,
          seasonTD / 8 * 100
        );


      const playerRecentScore =
        Math.min(
          100,
          recentTD / 3 * 100
        );


      const score =
        Math.round(

          positionScore * 0.30 +

          recentDefenseScore * 0.15 +

          overallDefenseScore * 0.10 +

          playerSeasonScore * 0.15 +

          playerRecentScore * 0.10 +

          opportunityScore * 0.20
        );


      // ======================================================
      // ADD PLAYER TO GAME
      // ======================================================

      game.players.push({

        player,

        team,

        pos,

        opponent,

        score,

        strength:
          getTDStrength(score),

        posAllowed,

        seasonTD,

        recentTD,

        opportunityScore,

        rzCarries,

        goalLine,

        rzTargets,

        inside10,

        rzShare,

        recentRZ,

        reason:
          buildAdvancedReason(
            pos,
            opponent,
            posAllowed,
            d.last3,
            seasonTD,
            recentTD,
            rzCarries,
            goalLine,
            rzTargets,
            inside10,
            rzShare,
            recentRZ
          )
      });
    }


    /*
     * Highest rated players first.
     */

    game.players.sort(
      (a, b) =>
        b.score - a.score
    );


    /*
     * Keep only top 3.
     */

    game.players =
      game.players.slice(0, 3);
  });


  // ==========================================================
  // BUILD OUTPUT
  // ==========================================================

  const output = [[
    'Week',
    'Game',
    'Game Time',
    'Rank',
    'Player',
    'Pos',
    'Team',
    'Opponent',
    'TD Score',
    'Strength',
    'Opportunity',
    'Why It Rates',
    'Game Summary'
  ]];


  Object.values(games)
    .forEach(game => {

      const summary =
        buildGameTDSummary(
          game
        );


      /*
       * Normally there will be 3 players,
       * but don't assume there always are.
       */

      if (!game.players.length) {

        output.push([
          week,
          game.away +
            ' @ ' +
            game.home,
          game.game,
          '',
          '',
          '',
          '',
          '',
          '',
          '',
          '',
          '',
          'No qualifying player data available.'
        ]);

        return;
      }


      game.players.forEach(
        (p, index) => {

          output.push([

            week,

            game.away +
              ' @ ' +
              game.home,

            game.game,

            index + 1,

            p.player,

            p.pos,

            p.team,

            p.opponent,

            p.score,

            p.strength,

            p.opportunityScore,

            p.reason,

            index === 0
              ? summary
              : ''
          ]);
        }
      );
    });


  // ==========================================================
  // WRITE SHEET
  // ==========================================================

  sheet.clear();


  ensureSize(
    sheet,
    output.length,
    output[0].length
  );


  sheet
    .getRange(
      1,
      1,
      output.length,
      output[0].length
    )
    .setValues(output);


  // ==========================================================
  // HEADER
  // ==========================================================

  sheet
    .getRange(
      1,
      1,
      1,
      output[0].length
    )
    .setBackground('#0d293f')
    .setFontColor('#ffffff')
    .setFontWeight('bold')
    .setWrap(true);


  sheet.setFrozenRows(1);


  // ==========================================================
  // FORMATTING
  // ==========================================================

  if (output.length > 1) {

    sheet
      .getRange(
        2,
        1,
        output.length - 1,
        output[0].length
      )
      .setVerticalAlignment(
        'middle'
      );


    /*
     * Explanation + summary wrapping
     */

    sheet
      .getRange(
        2,
        12,
        output.length - 1,
        2
      )
      .setWrap(true);


    /*
     * TD Score centered
     */

    sheet
      .getRange(
        2,
        9,
        output.length - 1,
        3
      )
      .setHorizontalAlignment(
        'center'
      );
  }


  // ==========================================================
  // COLUMN WIDTHS
  // ==========================================================

  const widths = [
    55,   // Week
    110,  // Game
    145,  // Time
    50,   // Rank
    165,  // Player
    55,   // Pos
    60,   // Team
    75,   // Opponent
    75,   // TD Score
    85,   // Strength
    90,   // Opportunity
    330,  // Why
    430   // Summary
  ];


  widths.forEach(
    (width, index) => {

      sheet.setColumnWidth(
        index + 1,
        width
      );
    }
  );


  // ==========================================================
  // CONDITIONAL FORMATTING
  // ==========================================================

  applyGameTargetFormatting(
    sheet,
    output.length - 1
  );
}

function getTDStrength(score) {

  if (score >= 80)
    return '🔥 Strong';

  if (score >= 70)
    return 'Strong';

  if (score >= 60)
    return 'Good';

  if (score >= 50)
    return 'Lean';

  return 'Weak';
}

function buildGameTDSummary(game) {

  if (
    !game.players ||
    !game.players.length
  ) {
    return 'No player data available.';
  }


  const p1 =
    game.players[0];

  const p2 =
    game.players[1];

  const p3 =
    game.players[2];


  let summary =
    'Top TD angle: ' +
    p1.player +
    ' (' +
    p1.team +
    ') at ' +
    p1.score +
    '/100. ';


  // ==========================================================
  // EXPLAIN TOP PLAY
  // ==========================================================

  if (p1.posAllowed >= 5) {

    summary +=
      p1.opponent +
      ' has been vulnerable to ' +
      p1.pos +
      ' touchdowns. ';
  }


  if (
    p1.goalLine >= 4
  ) {

    summary +=
      p1.player +
      ' has strong goal-line usage with ' +
      p1.goalLine +
      ' carries inside the 5. ';

  } else if (
    p1.inside10 >= 4
  ) {

    summary +=
      p1.player +
      ' has ' +
      p1.inside10 +
      ' targets inside the 10. ';

  } else if (
    p1.opportunityScore >= 80
  ) {

    summary +=
      'His scoring-opportunity profile is elite. ';
  }


  // ==========================================================
  // OTHER GOOD OPTIONS
  // ==========================================================

  const alternatives = [];


  if (
    p2 &&
    p2.score >= 60
  ) {

    alternatives.push(
      p2.player +
      ' (' +
      p2.score +
      ')'
    );
  }


  if (
    p3 &&
    p3.score >= 60
  ) {

    alternatives.push(
      p3.player +
      ' (' +
      p3.score +
      ')'
    );
  }


  if (alternatives.length) {

    summary +=
      'Other favorable options: ' +
      alternatives.join(', ') +
      '.';
  }


  // ==========================================================
  // WEAK GAME WARNING
  // ==========================================================

  if (p1.score < 60) {

    summary =
      'No strong Anytime TD spot stands out. ' +
      p1.player +
      ' is the highest-rated option at only ' +
      p1.score +
      '/100, so this profiles as a lower-priority game.';
  }


  return summary.trim();
}

function applyGameTargetFormatting(
  sheet,
  rows
) {

  if (!rows)
    return;

  const scoreRange =
    sheet.getRange(
      2,
      9,
      rows,
      1
    );

  const rules = [];

  // 80+
  rules.push(
    SpreadsheetApp
      .newConditionalFormatRule()
      .whenNumberGreaterThanOrEqualTo(80)
      .setBackground('#b6d7a8')
      .setRanges([scoreRange])
      .build()
  );

  // 70–79
  rules.push(
    SpreadsheetApp
      .newConditionalFormatRule()
      .whenNumberBetween(70, 79)
      .setBackground('#d9ead3')
      .setRanges([scoreRange])
      .build()
  );

  // 60–69
  rules.push(
    SpreadsheetApp
      .newConditionalFormatRule()
      .whenNumberBetween(60, 69)
      .setBackground('#fff2cc')
      .setRanges([scoreRange])
      .build()
  );

  // 50–59
  rules.push(
    SpreadsheetApp
      .newConditionalFormatRule()
      .whenNumberBetween(50, 59)
      .setBackground('#fce5cd')
      .setRanges([scoreRange])
      .build()
  );

  // Under 50
  rules.push(
    SpreadsheetApp
      .newConditionalFormatRule()
      .whenNumberLessThan(50)
      .setBackground('#f4cccc')
      .setRanges([scoreRange])
      .build()
  );

  sheet.setConditionalFormatRules(
    rules
  );
}

function buildWRMatchups() {

  const ss = SpreadsheetApp.getActive();

  const playersSheet =
    ss.getSheetByName('Players');

  const defenseSheet =
    ss.getSheetByName('Defense Rankings');

  const scheduleSheet =
    ss.getSheetByName('Schedule');

  const cbSheet =
    ss.getSheetByName('CB Coverage');

  const wrUsageSheet =
    ss.getSheetByName('WR Usage');


  if (
    !playersSheet ||
    !defenseSheet ||
    !scheduleSheet ||
    !cbSheet ||
    !wrUsageSheet
  ) {
    throw new Error(
      'Missing Players, Defense Rankings, Schedule, CB Coverage, or WR Usage sheet.'
    );
  }


  const currentWeek =
    getCurrentWeek();


  // ==========================================================
  // READ DATA
  // ==========================================================

  const players =
    playersSheet
      .getDataRange()
      .getValues();

  const defenses =
    defenseSheet
      .getDataRange()
      .getValues();

  const schedule =
    scheduleSheet
      .getDataRange()
      .getValues();

  const cbData =
    cbSheet
      .getDataRange()
      .getValues();

  const wrUsageData =
    wrUsageSheet
      .getDataRange()
      .getValues();


  // ==========================================================
  // WR USAGE LOOKUP
  // ==========================================================

  /*
   * WR Usage columns:
   *
   * B  WR
   * C  Team
   * H  Targets/Game
   * I  Target Share
   * L  Route Participation
   * S  Yards/Route Run
   * U  Air Yards Share
   * V  aDOT
   * W  WOPR
   * AD WR Usage Score
   * AE Usage Grade
   */

  const wrUsageMap = {};


  for (
    let i = 1;
    i < wrUsageData.length;
    i++
  ) {

    const row =
      wrUsageData[i];

    const player =
      String(row[1] || '')
        .trim()
        .toLowerCase();

    const team =
      normalizeNFLTeam(row[2]);


    if (
      !player ||
      !team
    ) {
      continue;
    }


    const key =
      player + '|' + team;


    wrUsageMap[key] = {

      targetsPerGame:
        numOrZero(row[7]),

      targetShare:
        nullableNumber(row[8]),

      routeParticipation:
        nullableNumber(row[11]),

      yprr:
        nullableNumber(row[18]),

      airYardsShare:
        nullableNumber(row[20]),

      adot:
        nullableNumber(row[21]),

      wopr:
        nullableNumber(row[22]),

      usageScore:
        numOrZero(row[29]),

      grade:
        row[30] || ''
    };
  }


  // ==========================================================
  // DEFENSE LOOKUP
  // ==========================================================

  const defenseMap = {};


  for (
    let i = 1;
    i < defenses.length;
    i++
  ) {

    const row =
      defenses[i];

    const defense =
      normalizeNFLTeam(row[1]);


    if (!defense) {
      continue;
    }


    defenseMap[defense] = {

      rank:
        numOrZero(row[0]),

      games:
        numOrZero(row[2]),

      totalTD:
        numOrZero(row[3]),

      tdPerGame:
        numOrZero(row[4]),

      passTD:
        numOrZero(row[5]),

      wrTD:
        numOrZero(row[7]),

      last3TD:
        numOrZero(row[12]),

      last3PerGame:
        numOrZero(row[13]),

      bestAttack:
        row[14] || '',

      trend:
        row[15] || ''
    };
  }


  // ==========================================================
  // BUILD SECONDARY / CB TEAM PROFILE
  // ==========================================================

  const secondaryMap = {};


  for (
    let i = 1;
    i < cbData.length;
    i++
  ) {

    const row =
      cbData[i];

    const team =
      normalizeNFLTeam(row[1]);


    if (!team) {
      continue;
    }


    if (!secondaryMap[team]) {

      secondaryMap[team] = {
        corners: []
      };
    }


    secondaryMap[team]
      .corners
      .push({

        name:
          row[0],

        targets:
          numOrZero(row[4]),

        td:
          numOrZero(row[7]),

        ypt:
          numOrZero(row[9]),

        epa:
          nullableNumber(row[10]),

        openRate:
          nullableNumber(row[16]),

        wideOpenRate:
          nullableNumber(row[17]),

        adot:
          nullableNumber(row[19]),

        manRate:
          nullableNumber(row[20]),

        zoneRate:
          nullableNumber(row[21]),

        singleHigh:
          nullableNumber(row[22]),

        twoHigh:
          nullableNumber(row[23]),

        trend:
          row[42] || '',

        weakness:
          numOrZero(row[43]),

        attackLevel:
          row[44] || ''
      });
  }


  // ==========================================================
  // TURN CBs INTO TEAM SECONDARY PROFILES
  // ==========================================================

  Object.keys(secondaryMap)
    .forEach(team => {

      const corners =
        secondaryMap[team].corners;


      corners.sort(
        (a, b) =>
          b.weakness -
          a.weakness
      );


      let weightedScore = 0;
      let totalWeight = 0;

      let weightedAdot = 0;
      let adotWeight = 0;

      let weightedMan = 0;
      let manWeight = 0;

      let weightedZone = 0;
      let zoneWeight = 0;

      let totalCBTD = 0;


      corners.forEach(cb => {

        const weight =
          Math.max(
            1,
            cb.targets
          );


        weightedScore +=
          cb.weakness *
          weight;

        totalWeight +=
          weight;


        totalCBTD +=
          cb.td;


        if (cb.adot !== null) {

          weightedAdot +=
            cb.adot *
            weight;

          adotWeight +=
            weight;
        }


        if (cb.manRate !== null) {

          weightedMan +=
            cb.manRate *
            weight;

          manWeight +=
            weight;
        }


        if (cb.zoneRate !== null) {

          weightedZone +=
            cb.zoneRate *
            weight;

          zoneWeight +=
            weight;
        }
      });


      secondaryMap[team].rating =
        totalWeight
          ? Math.round(
              weightedScore /
              totalWeight
            )
          : 50;


      secondaryMap[team].adot =
        adotWeight
          ? weightedAdot /
            adotWeight
          : null;


      secondaryMap[team].manRate =
        manWeight
          ? weightedMan /
            manWeight
          : null;


      secondaryMap[team].zoneRate =
        zoneWeight
          ? weightedZone /
            zoneWeight
          : null;


      secondaryMap[team].cbTD =
        totalCBTD;


      secondaryMap[team].worstCB =
        corners.length
          ? corners[0]
          : null;


      secondaryMap[team].secondWorstCB =
        corners.length > 1
          ? corners[1]
          : null;
    });


  // ==========================================================
  // THIS WEEK'S SCHEDULE LOOKUP
  // ==========================================================

  const matchupMap = {};


  for (
    let i = 1;
    i < schedule.length;
    i++
  ) {

    const row =
      schedule[i];

    const week =
      Number(row[1]);


    if (week !== currentWeek) {
      continue;
    }


    const away =
      normalizeNFLTeam(row[4]);

    const home =
      normalizeNFLTeam(row[5]);


    if (
      !away ||
      !home
    ) {
      continue;
    }


    matchupMap[away] = {

      opponent:
        home,

      location:
        'Away',

      date:
        row[2],

      time:
        row[3],

      gameId:
        row[8],

      status:
        row[9]
    };


    matchupMap[home] = {

      opponent:
        away,

      location:
        'Home',

      date:
        row[2],

      time:
        row[3],

      gameId:
        row[8],

      status:
        row[9]
    };
  }


  // ==========================================================
  // OUTPUT
  // ==========================================================

  const output = [[

    'Rank',
    'WR',
    'Team',
    'Opponent',
    'H/A',

    'Season TD',
    'Last 3 TD',

    'RZ Targets',
    'Inside 10 Targets',
    'RZ Opportunities',
    'Team RZ Share',
    'Last 3 RZ Opps',
    'TD/RZ Opportunity Score',

    'Targets / Game',
    'Target Share',
    'Route Participation',
    'Yards / Route Run',
    'Air Yards Share',
    'WR aDOT',
    'WOPR',
    'FTN WR Usage Score',
    'WR Usage Grade',

    'Opp WR TD Allowed',
    'Opp Pass TD',
    'Opp TD / Game',
    'Opp Last 3 TD / Game',
    'Defense Trend',

    'Secondary Rating',

    'Worst CB',
    'Worst CB Rating',
    'Worst CB Trend',

    '2nd Weak CB',
    '2nd Weak Rating',

    'CB TD Allowed',
    'Secondary aDOT',
    'Man Rate',
    'Zone Rate',

    'Defense WR Score',
    'Coverage Score',

    'WR Matchup Score',
    'Matchup Grade',

    'Summary'
  ]];


  // ==========================================================
  // BUILD EACH WR
  // ==========================================================

  for (
    let i = 1;
    i < players.length;
    i++
  ) {

    const row =
      players[i];


    const position =
      String(row[3] || '')
        .trim()
        .toUpperCase();


    if (position !== 'WR') {
      continue;
    }


    if (!isActiveNFLPlayer(row[14])) {
      continue;
    }


    const player =
      row[1];


    const team =
      normalizeNFLTeam(row[2]);


    if (
      !player ||
      !team
    ) {
      continue;
    }


    const game =
      matchupMap[team];


    if (!game) {
      continue;
    }


    const opponent =
      game.opponent;


    const defense =
      defenseMap[opponent] || {};


    const secondary =
      secondaryMap[opponent] || {};


    const worstCB =
      secondary.worstCB || {};


    const secondCB =
      secondary.secondWorstCB || {};


    // ========================================================
    // PLAYER TD / RED-ZONE DATA
    // ========================================================

    const seasonTD =
      numOrZero(row[4]);

    const last3TD =
      numOrZero(row[5]);

    const rzTargets =
      numOrZero(row[8]);

    const inside10 =
      numOrZero(row[9]);

    const rzOpps =
      numOrZero(row[10]);

    const rzShare =
      numOrZero(row[11]);

    const last3RZOpps =
      numOrZero(row[12]);

    const opportunityScore =
      numOrZero(row[13]);


    // ========================================================
    // FTN WR USAGE
    // ========================================================

    const usageKey =
      String(player)
        .trim()
        .toLowerCase() +
      '|' +
      team;


    const wrUsage =
      wrUsageMap[usageKey] || {};


    const targetsPerGame =
      numOrZero(
        wrUsage.targetsPerGame
      );


    const targetShare =
      wrUsage.targetShare !== undefined
        ? wrUsage.targetShare
        : null;


    const routeParticipation =
      wrUsage.routeParticipation !== undefined
        ? wrUsage.routeParticipation
        : null;


    const yprr =
      wrUsage.yprr !== undefined
        ? wrUsage.yprr
        : null;


    const airYardsShare =
      wrUsage.airYardsShare !== undefined
        ? wrUsage.airYardsShare
        : null;


    const wrAdot =
      wrUsage.adot !== undefined
        ? wrUsage.adot
        : null;


    const wopr =
      wrUsage.wopr !== undefined
        ? wrUsage.wopr
        : null;


    const ftnUsageScore =
      wrUsage.usageScore !== undefined
        ? numOrZero(
            wrUsage.usageScore
          )
        : 50;


    const wrUsageGrade =
      wrUsage.grade || '';


    // ========================================================
    // DEFENSE VS WR SCORE
    // ========================================================

    const wrTD =
      numOrZero(
        defense.wrTD
      );


    const passTD =
      numOrZero(
        defense.passTD
      );


    const tdPerGame =
      numOrZero(
        defense.tdPerGame
      );


    const last3PerGame =
      numOrZero(
        defense.last3PerGame
      );


    const wrTDScore =
      clamp100(
        wrTD / 8 * 100
      );


    const passTDScore =
      clamp100(
        passTD / 12 * 100
      );


    const tdGameScore =
      clamp100(
        tdPerGame / 4 * 100
      );


    const recentDefenseScore =
      clamp100(
        last3PerGame / 4 * 100
      );


    const defenseWRScore =
      Math.round(

        wrTDScore * 0.45 +

        passTDScore * 0.20 +

        tdGameScore * 0.15 +

        recentDefenseScore * 0.20
      );


    // ========================================================
    // ADVANCED COVERAGE SCORE
    // ========================================================

    const secondaryRating =
      secondary.rating !== undefined
        ? secondary.rating
        : 50;


    const worstRating =
      worstCB.weakness !== undefined
        ? worstCB.weakness
        : 50;


    const secondRating =
      secondCB.weakness !== undefined
        ? secondCB.weakness
        : 50;


    const coverageScore =
      Math.round(

        secondaryRating * 0.50 +

        worstRating * 0.30 +

        secondRating * 0.20
      );


    // ========================================================
    // TD / RED-ZONE OPPORTUNITY SCORE
    // ========================================================

    const normalizedOpportunity =
      clamp100(
        opportunityScore
      );


    const shareScore =
      clamp100(
        rzShare * 100
      );


    const recentRZScore =
      clamp100(
        last3RZOpps / 6 * 100
      );


    const inside10Score =
      clamp100(
        inside10 / 5 * 100
      );


    const tdRZScore =
      Math.round(

        normalizedOpportunity * 0.50 +

        shareScore * 0.20 +

        recentRZScore * 0.15 +

        inside10Score * 0.15
      );


    // ========================================================
    // FINAL WR MATCHUP SCORE
    // ========================================================

    /*
     * V2 MODEL
     *
     * 35% FTN receiving usage
     * 25% TD / red-zone opportunity
     * 25% opponent WR TD weakness
     * 15% advanced CB / secondary coverage
     */

    const matchupScore =
      Math.round(

        ftnUsageScore * 0.35 +

        tdRZScore * 0.25 +

        defenseWRScore * 0.25 +

        coverageScore * 0.15
      );


    // ========================================================
    // GRADE
    // ========================================================

    let grade;


    if (matchupScore >= 75) {

      grade =
        '🔥 Elite';

    } else if (matchupScore >= 65) {

      grade =
        'Strong';

    } else if (matchupScore >= 55) {

      grade =
        'Favorable';

    } else if (matchupScore >= 45) {

      grade =
        'Neutral';

    } else {

      grade =
        'Weak';
    }


    // ========================================================
    // SUMMARY
    // ========================================================

    const reasons = [];


    if (ftnUsageScore >= 85) {

      reasons.push(
        'elite receiving usage'
      );

    } else if (ftnUsageScore >= 75) {

      reasons.push(
        'high receiving usage'
      );
    }


    if (
      targetShare !== null &&
      targetShare >= 0.25
    ) {

      reasons.push(
        'commands a strong target share'
      );
    }


    if (targetsPerGame >= 8) {

      reasons.push(
        'heavy weekly target volume'
      );
    }


    if (tdRZScore >= 70) {

      reasons.push(
        'strong red-zone TD opportunity'
      );
    }


    if (inside10 >= 3) {

      reasons.push(
        'receives valuable inside-10 targets'
      );
    }


    if (wrTDScore >= 70) {

      reasons.push(
        'opponent allows heavy WR TD production'
      );
    }


    if (coverageScore >= 65) {

      reasons.push(
        'secondary grades as highly attackable'
      );
    }


    if (worstRating >= 70) {

      reasons.push(
        'opposing secondary features a Target-level vulnerable CB'
      );
    }


    if (last3PerGame >= 3) {

      reasons.push(
        'defense has struggled recently'
      );
    }


    if (
      String(worstCB.trend || '')
        .includes('Getting Worse')
    ) {

      reasons.push(
        'top vulnerable CB is trending worse'
      );
    }


    if (!reasons.length) {

      reasons.push(
        'no major matchup advantage identified'
      );
    }


    let summary =
      reasons
        .slice(0, 4)
        .join('; ');


    summary =
      summary.charAt(0)
        .toUpperCase() +
      summary.slice(1) +
      '.';


    // ========================================================
    // WRITE
    // ========================================================

    output.push([

      '',

      player,
      team,
      opponent,
      game.location,

      seasonTD,
      last3TD,

      rzTargets,
      inside10,
      rzOpps,
      rzShare,
      last3RZOpps,
      tdRZScore,

      targetsPerGame,
      nullableOutput(
        targetShare
      ),
      nullableOutput(
        routeParticipation
      ),
      nullableOutput(
        yprr
      ),
      nullableOutput(
        airYardsShare
      ),
      nullableOutput(
        wrAdot
      ),
      nullableOutput(
        wopr
      ),
      ftnUsageScore,
      wrUsageGrade,

      wrTD,
      passTD,
      tdPerGame,
      last3PerGame,
      defense.trend || '',

      secondaryRating,

      worstCB.name || '',
      worstRating,
      worstCB.trend || '',

      secondCB.name || '',
      secondRating,

      secondary.cbTD || 0,
      nullableOutput(
        secondary.adot
      ),
      nullableOutput(
        secondary.manRate
      ),
      nullableOutput(
        secondary.zoneRate
      ),

      defenseWRScore,
      coverageScore,

      matchupScore,
      grade,

      summary
    ]);
  }


  // ==========================================================
  // SORT BY MATCHUP SCORE
  // ==========================================================

  const header =
    output.shift();


  /*
   * WR Matchup Score = column AN in the output array.
   * Zero-based array index = 39.
   */

  output.sort(
    (a, b) =>
      Number(b[39]) -
      Number(a[39])
  );


  output.forEach(
    (row, index) => {

      row[0] =
        index + 1;
    }
  );


  output.unshift(header);


  // ==========================================================
  // CREATE / CLEAR SHEET
  // ==========================================================

  let sheet =
    ss.getSheetByName(
      'WR Matchups'
    );


  if (!sheet) {

    sheet =
      ss.insertSheet(
        'WR Matchups'
      );
  }


  sheet.clear();


  ensureSize(
    sheet,
    output.length,
    output[0].length
  );


  sheet
    .getRange(
      1,
      1,
      output.length,
      output[0].length
    )
    .setValues(
      output
    );


  // ==========================================================
  // HEADER
  // ==========================================================

  sheet
    .getRange(
      1,
      1,
      1,
      output[0].length
    )
    .setBackground(
      '#0d293f'
    )
    .setFontColor(
      '#ffffff'
    )
    .setFontWeight(
      'bold'
    )
    .setWrap(
      true
    );


  sheet.setFrozenRows(1);


  // ==========================================================
  // FORMATTING
  // ==========================================================

  if (output.length > 1) {

    const rows =
      output.length - 1;


    // Team RZ Share

    sheet
      .getRange(
        2,
        11,
        rows,
        1
      )
      .setNumberFormat(
        '0.0%'
      );


    // Target Share

    sheet
      .getRange(
        2,
        15,
        rows,
        1
      )
      .setNumberFormat(
        '0.0%'
      );


    // Route Participation

    sheet
      .getRange(
        2,
        16,
        rows,
        1
      )
      .setNumberFormat(
        '0.0%'
      );


    // Air Yards Share

    sheet
      .getRange(
        2,
        18,
        rows,
        1
      )
      .setNumberFormat(
        '0.0%'
      );


    // Targets/Game, YPRR, WR aDOT, WOPR

    [
      14,
      17,
      19,
      20
    ].forEach(col => {

      sheet
        .getRange(
          2,
          col,
          rows,
          1
        )
        .setNumberFormat(
          '0.0'
        );
    });

    // Secondary Rating

sheet
  .getRange(
    2,
    28,
    rows,
    1
  )
  .setNumberFormat(
    '0'
  );

    // Secondary aDOT

    sheet
      .getRange(
        2,
        35,
        rows,
        1
      )
      .setNumberFormat(
        '0.0'
      );


    // Man / Zone

    sheet
      .getRange(
        2,
        36,
        rows,
        2
      )
      .setNumberFormat(
        '0.0%'
      );


    // Final WR Matchup Score = column AN = 40

    const scoreRange =
      sheet.getRange(
        2,
        40,
        rows,
        1
      );


    const rules = [];


    rules.push(

      SpreadsheetApp
        .newConditionalFormatRule()
