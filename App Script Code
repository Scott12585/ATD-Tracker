function numOrZero(value) {

  const n =
    Number(value);

  return Number.isFinite(n)
    ? n
    : 0;
}


function nullableNumber(value) {

  if (
    value === '' ||
    value === null ||
    value === undefined
  ) {
    return null;
  }

  const n =
    Number(value);

  return Number.isFinite(n)
    ? n
    : null;
}


function isActiveNFLPlayer(value) {

  if (value === true) {
    return true;
  }

  const text =
    String(value || '')
      .trim()
      .toLowerCase();

  return (
    text === 'true' ||
    text === 'yes' ||
    text === 'active' ||
    text === '1' ||
    text === '✓'
  );
}


