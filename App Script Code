 ***************************************************************/

function getAny(
  row,
  map,
  names
) {

  for (
    const name of names
  ) {

    if (
      map[name] !== undefined &&
      row[map[name]] !== '' &&
      row[map[name]] !== null
    ) {
      return row[map[name]];
    }
  }

  return '';
}


function writeTable(
  sheetName,
  data
) {

  const sheet =
    SpreadsheetApp
      .getActive()
      .getSheetByName(
        sheetName
      );

  if (!sheet)
    throw new Error(
      'Missing sheet: ' +
      sheetName
    );


  sheet.clearContents();


  if (!data.length)
    return;


  ensureSize(
    sheet,
    data.length,
    data[0].length
  );


  sheet
    .getRange(
      1,
      1,
      data.length,
      data[0].length
    )
    .setValues(data);


  /*
   * Header formatting
   */

  sheet
    .getRange(
      1,
      1,
      1,
      data[0].length
    )
    .setBackground('#0d293f')
    .setFontColor('#ffffff')
    .setFontWeight('bold')
    .setWrap(true);


  sheet
    .setFrozenRows(1);


  sheet
    .autoResizeColumns(
      1,
      data[0].length
    );
}


function ensureSize(
  sheet,
  rows,
  cols
) {

  if (
    sheet.getMaxRows() < rows
  ) {

    sheet.insertRowsAfter(
      sheet.getMaxRows(),
      rows -
      sheet.getMaxRows()
    );
  }


  if (
    sheet.getMaxColumns() < cols
  ) {

    sheet.insertColumnsAfter(
      sheet.getMaxColumns(),
      cols -
      sheet.getMaxColumns()
    );
  }
}

/***************************************************************
 * CURRENT NFL ROSTERS
 *
 * Returns current 2026 roster information indexed by GSIS ID.
 * Used to:
 *   - correct stale team assignments
 *   - identify players no longer on an active roster
 ***************************************************************/

function getCurrentRosterMap() {

  const roster =
    fetchCSV(NFL.URLS.ROSTERS);

  if (!roster || roster.length < 2) {

    throw new Error(
      'Current roster data could not be loaded.'
    );
  }

  const h =
    columnMap(roster[0]);

  const map = {};


  for (let i = 1; i < roster.length; i++) {

    const r = roster[i];

    const id =
      getAny(r, h, [
        'gsis_id',
        'player_id'
      ]);

    if (!id)
      continue;


    const team =
      getAny(r, h, [
        'team',
        'recent_team'
      ]);


    const position =
      normalizePosition(
        getAny(r, h, [
          'position',
          'position_group'
        ])
      );


    const status =
      String(
        getAny(r, h, [
          'status',
          'roster_status'
        ]) || ''
      )
      .trim()
      .toUpperCase();


    map[id] = {

      team:
        String(team || '')
          .trim()
          .toUpperCase(),

      position,

      status,

      active:
        isActiveRosterStatus(status)
    };
  }


  return map;
}

function isActiveRosterStatus(status) {

  status =
    String(status || '')
      .trim()
      .toUpperCase();


  /*
   * nflverse roster statuses can vary.
   *
   * We want players who are currently available
   * on the active roster.
   */

  const inactiveStatuses = [
    'RES',
    'RET',
    'DEV',
    'CUT',
    'WAV',
    'SUS',
    'PUP',
    'NFI',
    'IR',
    'EXE'
  ];


  if (!status)
    return true;


  return !inactiveStatuses.some(
    s =>
      status === s ||
      status.startsWith(s + '-')
  );
}

