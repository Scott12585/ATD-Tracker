// ==========================================================
// SYNC HELPERS
// ==========================================================

function numberOrNull_(
  value
) {

  if (
    value === '' ||
    value === null ||
    value === undefined
  ) {
    return null;
  }


  const n =
    Number(value);


  return Number.isFinite(n)
    ? n
    : null;
}


function dateToISO_(
  value
) {

  if (!value) {
    return null;
  }


  if (
    Object.prototype
      .toString
      .call(value) ===
      '[object Date]' &&
    !isNaN(value)
  ) {

    return Utilities
      .formatDate(
        value,
        Session
          .getScriptTimeZone(),
        'yyyy-MM-dd'
      );
  }


  const d =
    new Date(value);


  if (isNaN(d)) {
    return null;
  }


  return Utilities
    .formatDate(
      d,
      Session
        .getScriptTimeZone(),
      'yyyy-MM-dd'
    );
}


function timeToText_(
  value
) {

  if (!value) {
    return '';
  }


  if (
    Object.prototype
      .toString
      .call(value) ===
      '[object Date]' &&
    !isNaN(value)
  ) {

    return Utilities
      .formatDate(
        value,
        Session
          .getScriptTimeZone(),
        'h:mm a'
      );
  }


  return String(value);
}

