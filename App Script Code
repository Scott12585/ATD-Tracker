/***************************************************************
 * FETCH FTN COVERAGE
 ***************************************************************/

function fetchAdvancedCBCoverageData(
  weeks
) {

  const tables = [

    'overview',
    'analytics',
    'coverage-quality',
    'air-yards',
    'coverage-types'

  ];


  const players = {};


  tables.forEach(table => {

    let url =
      'https://stats.ftnfantasy.com/api/v1/stats/categories/coverage/tables/' +
      table +
      '?season=2026' +
      '&seasonType=REG';


    if (
      weeks &&
      weeks.length
    ) {

      url +=
        '&weeks=' +
        encodeURIComponent(
          weeks.join(',')
        );
    }


    url +=
      '&qualified=true' +
      '&page=1' +
      '&pageSize=500';


    const response =
      UrlFetchApp.fetch(
        url,
        {
          method: 'get',

          muteHttpExceptions:
            true,

          headers: {
            'Accept':
              'application/json'
          }
        }
      );


    const status =
      response.getResponseCode();


    if (status !== 200) {

      throw new Error(
        'FTN ' +
        table +
        ' request failed. HTTP ' +
        status
      );
    }


    const json =
      JSON.parse(
        response.getContentText()
      );


    const rows =
      json.data &&
      json.data.rows
        ? json.data.rows
        : [];


    rows.forEach(row => {

      if (
        String(row.position)
          .toUpperCase() !== 'CB'
      ) {
        return;
      }


      const id =
        String(row.entityId);


      if (!players[id]) {

        players[id] = {

          entityId:
            row.entityId,

          name:
            row.entityName,

          team:
            row.team

        };
      }


      players[id][table] =
        row;
    });
  });


  return players;
}

function calculateAdvancedCoverageWeakness(
  data
) {

  // ==========================================================
  // RESULTS — 35%
  // ==========================================================

  const ypt =
    data.targets
      ? data.yards / data.targets
      : 0;


  // 12 YPT is treated as extremely poor.
  const yptScore =
    clamp100(
      ypt / 12 * 100
    );


  const catchScore =
    clamp100(
      (data.catchRate || 0) * 100
    );


  /*
   * TD rate is better than raw TD count here.
   *
   * 15% TD/target is extremely poor.
   */

  const tdRate =
    data.targets
      ? data.tds / data.targets
      : 0;


  const tdScore =
    clamp100(
      tdRate / 0.15 * 100
    );


  const resultsScore =
    Math.round(

      yptScore * 0.40 +

      catchScore * 0.30 +

      tdScore * 0.30
    );


  // ==========================================================
  // COVERAGE QUALITY — 25%
  // ==========================================================

  /*
   * Open / wide-open are bad.
   * Tight coverage is good.
   *
   * Step coverage is treated close to neutral.
   */

  const openScore =
    data.openRate === null
      ? 50
      : clamp100(
          data.openRate / 0.50 * 100
        );


  const wideOpenScore =
    data.wideOpenRate === null
      ? 50
      : clamp100(
          data.wideOpenRate / 0.25 * 100
        );


  const tightWeakness =
    data.tightRate === null
      ? 50
      : clamp100(
          100 -
          (
            data.tightRate /
            0.60 *
            100
          )
        );


  const qualityScore =
    Math.round(

      openScore * 0.40 +

      wideOpenScore * 0.35 +

      tightWeakness * 0.25
    );


  // ==========================================================
  // ADVANCED EFFICIENCY — 25%
  // ==========================================================

  /*
   * These are centered around neutral performance.
   *
   * Positive EPA/DVOA/CPOE-type results against the defender
   * increase vulnerability.
   */


  // -0.75 EPA = excellent
  // +0.75 EPA = very poor

  const epaScore =
    data.epa === null
      ? 50
      : normalizeRange(
          data.epa,
          -0.75,
          0.75
        );


  // -75% DVOA = excellent
  // +75% DVOA = very poor

  const dvoaScore =
    data.dvoa === null
      ? 50
      : normalizeRange(
          data.dvoa,
          -0.75,
          0.75
        );


  /*
   * Higher offensive success rate against the CB
   * means greater weakness.
   */

  const successScore =
    data.successRate === null
      ? 50
      : clamp100(
          data.successRate /
          0.75 *
          100
        );


  /*
   * Lockdown rate works the opposite direction.
   */

  const lockdownWeakness =
    data.lockdownRate === null
      ? 50
      : clamp100(
          100 -
          (
            data.lockdownRate /
            0.60 *
            100
          )
        );


  const efficiencyScore =
    Math.round(

      epaScore * 0.30 +

      dvoaScore * 0.25 +

      successScore * 0.25 +

      lockdownWeakness * 0.20
    );


  // ==========================================================
  // EXPOSURE — 15%
  // ==========================================================

  /*
   * Defenders targeted on 25% of covered routes
   * receive an exposure score of 100.
   */

  const exposureScore =
    Math.round(
      clamp100(
        (data.targetRate || 0) /
        0.25 *
        100
      )
    );


  // ==========================================================
  // FINAL RAW SCORE
  // ==========================================================

  const total =
    Math.round(

      resultsScore * 0.35 +

      qualityScore * 0.25 +

      efficiencyScore * 0.25 +

      exposureScore * 0.15
    );


  return {

    results:
      resultsScore,

    quality:
      qualityScore,

    efficiency:
      efficiencyScore,

    exposure:
      exposureScore,

    total:
      clamp100(total)

  };
}

function ftnValue(
  row,
  field
) {

  if (
    !row ||
    row[field] === null ||
    row[field] === undefined ||
    row[field] === ''
  ) {
    return null;
  }


  const value =
    Number(
      row[field]
    );


  return Number.isFinite(value)
    ? value
    : null;
}


function nullableOutput(
  value
) {

  return value === null ||
         value === undefined
    ? ''
    : value;
}


function clamp100(
  value
) {

  return Math.max(
    0,
    Math.min(
      100,
      value
    )
  );
}


function normalizeRange(
  value,
  min,
  max
) {

  if (
    value === null ||
    value === undefined
  ) {
    return 50;
  }


  const normalized =
    (
      (value - min) /
      (max - min)
    ) * 100;


  return clamp100(
    normalized
  );
}

function formatAdvancedCBCoverage(
  sheet,
  rows
) {

  if (!rows) {
    return;
  }


  // ==========================================================
  // PERCENTAGES
  // ==========================================================

  const percentageColumns = [

    9,   // Catch Rate

    12,  // DVOA
    13,  // Success Rate
    14,  // Lockdown

    15,  // Tight
    16,  // Step
    17,  // Open
    18,  // Wide Open

    19,  // Target Rate

    21,  // Man
    22,  // Zone
    23,  // Single High
    24,  // 2 High

    30,  // Season Reliability

    35,  // L3 Catch Rate

    41   // L3 Reliability
  ];


  percentageColumns.forEach(col => {

    sheet
      .getRange(
        2,
        col,
        rows,
        1
      )
      .setNumberFormat(
        '0.0%'
      );
  });


  // ==========================================================
  // DECIMAL COLUMNS
  // ==========================================================

  const oneDecimalColumns = [

    10,  // YPT
    20,  // aDOT
    36   // L3 YPT

  ];


  oneDecimalColumns.forEach(col => {

    sheet
      .getRange(
        2,
        col,
        rows,
        1
      )
      .setNumberFormat(
        '0.0'
      );
  });


  // EPA

  sheet
    .getRange(
