        ftnValue(
          usage,
          'nfl.receiving.target_rate'
        );


      const routes =
        ftnNum(
          usage,
          'nfl.receiving.routes'
        );


      const routeParticipation =
        ftnValue(
          usage,
          'nfl.receiving.route_participation'
        );


      const firstReadTargets =
        ftnNum(
          usage,
          'nfl.receiving.first_read_targets'
        );


      const firstReadRate =
        ftnValue(
          usage,
          'nfl.receiving.first_read_target_rate'
        );


      // ======================================================
      // PRODUCTION
      // ======================================================

      const receptions =
        ftnNum(
          overview,
          'nfl.receiving.receptions'
        );


      const yards =
        ftnNum(
          overview,
          'nfl.receiving.yards'
        );


      const touchdowns =
        ftnNum(
          overview,
          'nfl.receiving.touchdowns'
        );


      const yardsPerTarget =
        ftnValue(
          overview,
          'nfl.receiving.yards_per_target'
        );


      const yprr =
        ftnValue(
          efficiency,
          'nfl.receiving.yards_per_route_run'
        );


      // ======================================================
      // AIR YARDS / ROLE
      // ======================================================

      const airYards =
        ftnNum(
          air,
          'nfl.receiving.air_yards'
        );


      const airYardsShare =
        ftnValue(
          air,
          'nfl.receiving.air_yards_share'
        );


      const adot =
        ftnValue(
          air,
          'nfl.receiving.average_depth_of_target'
        );


      const wopr =
        ftnValue(
          air,
          'nfl.receiving.wopr'
        );


      // ======================================================
      // ANALYTICS
      // ======================================================

      const epaRoute =
        ftnValue(
          analytics,
          'nfl.receiving.epa_route'
        );


      const epaTarget =
        ftnValue(
          analytics,
          'nfl.receiving.epa_target'
        );


      const separation =
        ftnValue(
          analytics,
          'nfl.receiving.separation_rate'
        );


      // ======================================================
      // VOLUME SCORE
      // ======================================================

      /*
       * 10 targets/game = elite
       * 30% target share = elite
       * 90% route participation = elite
       * 80% first-read rate = elite
       */

      const targetVolumeScore =
        clamp100(
          targetsPerGame /
          10 *
          100
        );


      const targetShareScore =
        targetShare === null
          ? 50
          : clamp100(
              targetShare /
              0.30 *
              100
            );


      const routeScore =
        routeParticipation === null
          ? 50
          : clamp100(
              routeParticipation /
              0.90 *
              100
            );


      const firstReadScore =
        firstReadRate === null
          ? 50
          : clamp100(
              firstReadRate /
              0.80 *
              100
            );


      const volumeScore =
        Math.round(

          targetVolumeScore * 0.35 +

          targetShareScore * 0.30 +

          routeScore * 0.20 +

          firstReadScore * 0.15
        );


      // ======================================================
      // ROLE SCORE
      // ======================================================

      /*
       * Air-yards share and WOPR tell us how important
       * the receiver is to the passing offense.
       *
       * aDOT is NOT inherently good or bad, so we don't
       * score it here. We'll use aDOT later for matchup fit.
       */


      const airShareScore =
        airYardsShare === null
          ? 50
          : clamp100(
              airYardsShare /
              0.40 *
              100
            );


      const woprScore =
        wopr === null
          ? 50
          : clamp100(
              wopr /
              0.75 *
              100
            );


      const roleScore =
        Math.round(

          airShareScore * 0.50 +

          woprScore * 0.50
        );


      // ======================================================
      // EFFICIENCY SCORE
      // ======================================================

      /*
       * Efficiency gets less influence than opportunity.
       * We don't want a few explosive catches to make a
       * low-volume WR look like an elite TD candidate.
       */


      const yprrScore =
        yprr === null
          ? 50
          : clamp100(
              yprr /
              3.0 *
              100
            );


      const yptScore =
        yardsPerTarget === null
          ? 50
          : clamp100(
              yardsPerTarget /
              12 *
              100
            );


      const epaScore =
        epaTarget === null
          ? 50
          : normalizeRange(
              epaTarget,
              -0.5,
              1.0
            );


      const efficiencyScore =
        Math.round(

          yprrScore * 0.45 +

          yptScore * 0.30 +

          epaScore * 0.25
        );


      // ======================================================
      // FINAL WR USAGE SCORE
      // ======================================================

      const usageScore =
        Math.round(

          volumeScore * 0.60 +

          roleScore * 0.25 +

          efficiencyScore * 0.15
        );


      let grade;


      if (usageScore >= 85) {

        grade =
          '🔥 Elite';

      } else if (usageScore >= 75) {

        grade =
          'High';

      } else if (usageScore >= 65) {

        grade =
          'Strong';

      } else if (usageScore >= 55) {

        grade =
          'Moderate';

      } else {

        grade =
          'Low';
      }


      output.push([

        '',

        player.name,
        player.team,

        games,
        snaps,
        nullableOutput(
          snapShare
        ),

        targets,
        targetsPerGame,
        nullableOutput(
          targetShare
        ),
        nullableOutput(
          targetRate
        ),

        routes,
        nullableOutput(
          routeParticipation
        ),

        firstReadTargets,
        nullableOutput(
          firstReadRate
        ),

        receptions,
        yards,
        touchdowns,

        nullableOutput(
          yardsPerTarget
        ),

        nullableOutput(
          yprr
        ),

        airYards,

        nullableOutput(
          airYardsShare
        ),

        nullableOutput(
          adot
        ),

        nullableOutput(
          wopr
        ),

        nullableOutput(
          epaRoute
        ),

        nullableOutput(
          epaTarget
        ),

        nullableOutput(
          separation
        ),

        volumeScore,
        roleScore,
        efficiencyScore,

        usageScore,
        grade
      ]);
    });


  // ==========================================================
  // SORT
  // ==========================================================

  const header =
    output.shift();


  output.sort(
    (a, b) =>
      Number(b[29]) -
      Number(a[29])
  );


  output.forEach(
    (row, index) => {

      row[0] =
        index + 1;
    }
  );


  output.unshift(header);


  // ==========================================================
  // CREATE WR USAGE SHEET
  // ==========================================================

  let sheet =
    ss.getSheetByName(
      'WR Usage'
    );


  if (!sheet) {

    sheet =
      ss.insertSheet(
        'WR Usage'
      );
  }


  sheet.clear();


  sheet
    .getRange(
      1,
      1,
      sheet.getMaxRows(),
      sheet.getMaxColumns()
    )
    .setNumberFormat(
      'General'
    );


  ensureSize(
    sheet,
    output.length,
    output[0].length
  );


  sheet
    .getRange(
      1,
      1,
      output.length,
      output[0].length
    )
    .setValues(
      output
    );


  // ==========================================================
  // FORMAT
  // ==========================================================

  sheet
    .getRange(
      1,
      1,
      1,
      output[0].length
    )
    .setBackground(
      '#0d293f'
    )
    .setFontColor(
      '#ffffff'
    )
    .setFontWeight(
      'bold'
    )
    .setWrap(
      true
    );


  sheet.setFrozenRows(1);


  if (output.length > 1) {

    const rows =
      output.length - 1;


    // Percentage fields

    const percentCols = [
      6,   // Snap Share
      9,   // Target Share
      10,  // Target Rate
      12,  // Route Participation
      14,  // First Read Rate
      21,  // Air Yards Share
      26   // Separation Rate
    ];


    percentCols.forEach(col => {

      sheet
        .getRange(
          2,
          col,
          rows,
          1
        )
        .setNumberFormat(
          '0.0%'
        );
    });


    // Decimal fields

    const decimalCols = [
      8,   // Targets/Game
      18,  // YPT
      19,  // YPRR
      22,  // aDOT
      23   // WOPR
    ];


    decimalCols.forEach(col => {

      sheet
        .getRange(
          2,
          col,
          rows,
          1
        )
        .setNumberFormat(
          '0.0'
        );
    });


    // EPA

    sheet
      .getRange(
        2,
        24,
        rows,
        2
      )
      .setNumberFormat(
        '0.00'
      );


    // Usage Score formatting

    const scoreRange =
      sheet.getRange(
        2,
        30,
        rows,
        1
      );


    const rules = [];


    rules.push(

      SpreadsheetApp
        .newConditionalFormatRule()
        .whenNumberGreaterThanOrEqualTo(85)
        .setBackground('#b6d7a8')
        .setRanges([scoreRange])
        .build()
    );


    rules.push(

      SpreadsheetApp
        .newConditionalFormatRule()
        .whenNumberBetween(
          75,
          84.999
        )
        .setBackground('#d9ead3')
        .setRanges([scoreRange])
        .build()
    );


    rules.push(

      SpreadsheetApp
        .newConditionalFormatRule()
        .whenNumberBetween(
          65,
          74.999
        )
        .setBackground('#fff2cc')
        .setRanges([scoreRange])
        .build()
    );


    rules.push(

      SpreadsheetApp
        .newConditionalFormatRule()
        .whenNumberLessThan(55)
        .setBackground('#f4cccc')
        .setRanges([scoreRange])
        .build()
    );


    sheet.setConditionalFormatRules(
      rules
    );
  }


  sheet.autoResizeColumns(
    1,
    output[0].length
  );


  sheet.setColumnWidth(
    2,
    180
  );


  sheet.setColumnWidth(
    3,
    90
  );


  sheet
    .getRange('A1')
    .setNote(
      'FTN WR Usage model. Usage Score emphasizes targets, target share, route participation and first-read usage. Air yards and efficiency supplement volume but do not overpower it.'
    );


  ss.toast(
    'WR Usage database updated!',
    'NFL TD Tracker',
    5
  );
}



function buildBestPlays() {

  const ss = SpreadsheetApp.getActive();

  const source =
    ss.getSheetByName('WR Matchups');

  if (!source) {
    throw new Error(
      'WR Matchups sheet not found.'
    );
  }

  const data =
    source.getDataRange().getValues();

  if (data.length < 2) {
    throw new Error(
      'WR Matchups has no player data.'
    );
  }


  // ==========================================================
  // FIND COLUMNS BY HEADER NAME
  // ==========================================================

  const headers =
    data[0].map(
      h => String(h).trim()
    );


  function col(name) {

    const index =
      headers.indexOf(name);

    if (index === -1) {
      throw new Error(
        'WR Matchups column not found: ' +
        name
      );
    }

    return index;
  }


  const C = {

    player:
      col('WR'),

    team:
      col('Team'),

    opponent:
      col('Opponent'),

    location:
      col('H/A'),

    seasonTD:
      col('Season TD'),

    last3TD:
      col('Last 3 TD'),

    rzTargets:
      col('RZ Targets'),

    inside10:
      col('Inside 10 Targets'),

    tdRZ:
      col('TD/RZ Opportunity Score'),

    targetsGame:
      col('Targets / Game'),

    targetShare:
      col('Target Share'),

    routeParticipation:
      col('Route Participation'),

    yprr:
      col('Yards / Route Run'),

    airShare:
      col('Air Yards Share'),

    adot:
      col('WR aDOT'),

    wopr:
      col('WOPR'),

    usage:
      col('FTN WR Usage Score'),

    wrTDAllowed:
      col('Opp WR TD Allowed'),

    defenseTrend:
      col('Defense Trend'),

    secondary:
      col('Secondary Rating'),

    worstCB:
      col('Worst CB'),

    worstCBRating:
      col('Worst CB Rating'),

    defenseScore:
      col('Defense WR Score'),

    coverage:
      col('Coverage Score'),

    matchup:
      col('WR Matchup Score')
  };


  // ==========================================================
  // BUILD CANDIDATES
  // ==========================================================

  const candidates = [];


  for (
    let i = 1;
    i < data.length;
    i++
  ) {

    const row =
      data[i];

    const player =
      row[C.player];

    if (!player) {
      continue;
    }


    const usage =
      numOrZero(
        row[C.usage]
      );

    const tdRZ =
      numOrZero(
        row[C.tdRZ]
      );

    const defense =
      numOrZero(
        row[C.defenseScore]
      );

    const coverage =
      numOrZero(
        row[C.coverage]
      );

    const matchup =
      numOrZero(
        row[C.matchup]
      );

    const targetShare =
      numOrZero(
        row[C.targetShare]
      );

    const targetsGame =
      numOrZero(
        row[C.targetsGame]
      );

    const inside10 =
      numOrZero(
        row[C.inside10]
      );

    const rzTargets =
      numOrZero(
        row[C.rzTargets]
      );

    const seasonTD =
      numOrZero(
        row[C.seasonTD]
      );

    const last3TD =
      numOrZero(
        row[C.last3TD]
      );

    const worstCBRating =
      numOrZero(
        row[C.worstCBRating]
      );


    // ========================================================
    // DETERMINE PLAY TYPE
    // ========================================================

    const types = [];


    // ========================================================
    // BEST OVERALL
    // ========================================================

    /*
     * Strong overall TD candidate.
     *
     * We still use the broader WR Matchup Score here,
     * but require strong individual usage and either
     * meaningful TD opportunity or an excellent opponent.
     */

    if (
      matchup >= 70 &&
      usage >= 75 &&
      (
        tdRZ >= 55 ||
        defense >= 65
      )
    ) {

      types.push({
        name: '🔥 Best Overall',
        priority: 5
      });
    }


    // ========================================================
    // RED-ZONE PLAY
    // ========================================================

    if (
      tdRZ >= 60 &&
      (
        inside10 >= 3 ||
        last3TD >= 2
      )
    ) {

      types.push({
        name: '🔴 Red-Zone Play',
        priority: 4
      });
    }


    // ========================================================
    // VOLUME PLAY
    // ========================================================

    /*
     * High volume alone is not enough for an anytime-TD play.
     *
     * Require at least some legitimate TD/RZ opportunity.
     */

    if (
      usage >= 80 &&
      tdRZ >= 25 &&
      (
        targetsGame >= 8 ||
        targetShare >= 0.25
      )
    ) {

      types.push({
        name: '🎯 Volume Play',
        priority: 3
      });
    }


    // ========================================================
    // MATCHUP PLAY
    // ========================================================

    /*
     * A bad opposing defense cannot carry a receiver who has
     * essentially no individual touchdown opportunity.
     */

    if (
      defense >= 65 &&
      usage >= 60 &&
      tdRZ >= 20 &&
      targetsGame >= 4 &&
      (
        coverage >= 55 ||
        worstCBRating >= 65
      )
    ) {

      types.push({
        name: '⚡ Matchup Play',
        priority: 2
      });
    }


    // ========================================================
    // SLEEPER
    // ========================================================

    /*
     * Sleeper requires:
     *
     * - decent overall matchup
     * - legitimate role
     * - some TD opportunity
     * - favorable defense/coverage signal
     */

    if (
      matchup >= 54 &&
      matchup < 70 &&
      usage >= 60 &&
      usage < 80 &&
      tdRZ >= 20 &&
      targetsGame >= 4 &&
      (
        defense >= 65 ||
        coverage >= 60
      )
    ) {

      types.push({
        name: '💎 Sleeper',
        priority: 1
      });
    }


    // No qualifying signal = no Best Plays appearance

    if (!types.length) {
      continue;
    }


    types.sort(
      (a, b) =>
        b.priority -
        a.priority
    );


    const playType =
      types[0].name;


    // ========================================================
    // TD-SPECIFIC CONFIDENCE SCORE
    // ========================================================

    /*
     * IMPORTANT:
     *
     * Confidence no longer starts with WR Matchup Score.
     *
     * That prevented double-counting because WR Matchup
     * already contains Usage, TD/RZ, Defense and Coverage.
     *
     * New base:
     *
     * 35% WR Usage
     * 35% TD / Red-Zone Opportunity
     * 20% Defense vs WR
     * 10% Coverage
     *
     * This makes individual TD opportunity equally important
     * as overall receiving usage.
     */

    let confidence =
      (
        usage * 0.35
      ) +
      (
        tdRZ * 0.35
      ) +
      (
        defense * 0.20
      ) +
      (
        coverage * 0.10
      );


    // ========================================================
    // SMALL TD-SPECIFIC BONUSES
    // ========================================================

    /*
     * Bonuses are intentionally small.
     *
     * They reward particularly strong touchdown indicators
     * without allowing us to double-count the entire model.
     */


    // Heavy inside-10 involvement

    if (inside10 >= 5) {

      confidence += 5;

    } else if (inside10 >= 3) {

      confidence += 3;

    } else if (inside10 >= 2) {

      confidence += 1;
    }


    // Strong overall red-zone target volume

    if (rzTargets >= 8) {

      confidence += 3;

    } else if (rzTargets >= 5) {

      confidence += 2;
    }


    // Recent scoring form

    if (last3TD >= 3) {

      confidence += 3;

    } else if (last3TD >= 2) {

      confidence += 2;

    } else if (last3TD >= 1) {

      confidence += 1;
    }


    // Extremely strong target dominance

    if (targetShare >= 0.30) {

      confidence += 2;

    } else if (targetShare >= 0.25) {

      confidence += 1;
    }


    // Extremely heavy weekly target volume

    if (targetsGame >= 10) {

      confidence += 2;

    } else if (targetsGame >= 8) {

      confidence += 1;
    }


    // Cap score at 99

    confidence =
      Math.min(
        99,
        Math.round(confidence)
      );


    // ========================================================
    // BUILD EXPLANATION
    // ========================================================

    const reasons = [];


    // Usage

    if (usage >= 90) {

      reasons.push(
        'elite WR usage'
      );

    } else if (usage >= 80) {

      reasons.push(
        'high WR usage'
      );
    }


    // Volume

    if (targetsGame >= 10) {

      reasons.push(
        targetsGame.toFixed(1) +
        ' targets/game'
      );

    } else if (targetShare >= 0.25) {

      reasons.push(
        Math.round(
          targetShare * 100
        ) +
        '% target share'
      );
    }


    // TD/RZ opportunity

    if (tdRZ >= 65) {

      reasons.push(
        'strong TD/red-zone opportunity'
      );

    } else if (tdRZ >= 50) {

      reasons.push(
        'positive TD/red-zone opportunity'
      );
    }


    // Inside 10

    if (inside10 >= 3) {

      reasons.push(
        inside10 +
        ' inside-10 targets'
      );
    }


    // Opponent

    if (defense >= 80) {

      reasons.push(
        'elite opponent TD matchup'
      );

    } else if (defense >= 65) {

      reasons.push(
        'favorable opponent TD matchup'
      );
    }


    // Coverage

    if (coverage >= 65) {

      reasons.push(
        'attackable secondary'
      );
    }


    // Weak CB

    if (worstCBRating >= 65) {

      const cbName =
        row[C.worstCB] ||
        'opposing CB';

      reasons.push(
        cbName +
        ' grades as vulnerable'
      );
    }


    // Defensive trend

    if (
      String(
        row[C.defenseTrend] || ''
      ).includes('Worse')
    ) {

      reasons.push(
        'defense trending worse'
      );
    }


    let keyReason =
      reasons
        .slice(0, 4)
        .join('; ');


    if (!keyReason) {

      keyReason =
        'Multiple positive touchdown indicators';
    }


    keyReason =
      keyReason.charAt(0)
        .toUpperCase() +
      keyReason.slice(1) +
      '.';


    // ========================================================
    // SAVE CANDIDATE
    // ========================================================

    candidates.push({

      player:
        player,

      team:
        row[C.team],

      opponent:
        row[C.opponent],

      location:
        row[C.location],

      playType:
        playType,

      confidence:
        confidence,

      matchup:
        matchup,

      usage:
        usage,

      tdRZ:
        tdRZ,

      defense:
        defense,

      coverage:
        coverage,

      seasonTD:
        seasonTD,

      last3TD:
        last3TD,

      targetsGame:
        targetsGame,

      targetShare:
        targetShare,

      inside10:
        inside10,

      worstCB:
        row[C.worstCB] || '',

      worstCBRating:
        worstCBRating,

      reason:
        keyReason
    });
  }


  // ==========================================================
  // SORT
  // ==========================================================

  candidates.sort(
    (a, b) => {

      if (
        b.confidence !==
        a.confidence
      ) {

        return (
          b.confidence -
          a.confidence
        );
      }


      if (
        b.tdRZ !==
        a.tdRZ
      ) {

        return (
          b.tdRZ -
          a.tdRZ
        );
      }


      return (
        b.matchup -
        a.matchup
      );
    }
  );


  // ==========================================================
  // OUTPUT
  // ==========================================================

  const output = [[

    'Rank',
    'Player',
    'Team',
    'Opponent',
    'H/A',

    'Play Type',
    'Confidence',

    'Matchup Score',
    'WR Usage',
    'TD/RZ',
    'Defense',
    'Coverage',

    'Season TD',
    'Last 3 TD',

    'Targets/Game',
    'Target Share',
    'Inside 10',

    'Weakest CB',
    'CB Weakness',

    'Key Reason'
  ]];


  candidates.forEach(
    (p, index) => {

      output.push([

        index + 1,

        p.player,
        p.team,
        p.opponent,
        p.location,

        p.playType,
        p.confidence,

        p.matchup,
        p.usage,
        p.tdRZ,
        p.defense,
        p.coverage,

        p.seasonTD,
        p.last3TD,

        p.targetsGame,
        p.targetShare,
        p.inside10,

        p.worstCB,
        p.worstCBRating,

        p.reason
      ]);
    }
  );


  // ==========================================================
  // CREATE SHEET
  // ==========================================================

  let sheet =
    ss.getSheetByName(
      'Best Plays'
    );


  if (!sheet) {

    sheet =
      ss.insertSheet(
        'Best Plays'
      );
  }


  sheet.clear();


  ensureSize(
    sheet,
    output.length,
    output[0].length
  );


  sheet
    .getRange(
      1,
      1,
      output.length,
      output[0].length
    )
    .setValues(output);


  // ==========================================================
  // HEADER
  // ==========================================================

  sheet
    .getRange(
      1,
      1,
      1,
      output[0].length
    )
    .setBackground('#0d293f')
    .setFontColor('#ffffff')
    .setFontWeight('bold')
    .setWrap(true);


  sheet.setFrozenRows(1);


  // ==========================================================
  // FORMATTING
  // ==========================================================

  if (output.length > 1) {

    const rows =
      output.length - 1;


    // Targets/game

    sheet
      .getRange(
        2,
        15,
        rows,
        1
      )
      .setNumberFormat(
        '0.0'
      );


    // Target share

    sheet
      .getRange(
        2,
        16,
        rows,
        1
      )
      .setNumberFormat(
        '0.0%'
      );


    // Score columns

    sheet
      .getRange(
        2,
        7,
        rows,
        6
      )
      .setNumberFormat(
        '0'
      );


    // CB weakness

    sheet
      .getRange(
        2,
        19,
        rows,
        1
      )
      .setNumberFormat(
        '0'
      );


    const confidenceRange =
      sheet.getRange(
        2,
        7,
        rows,
        1
      );


    const rules = [];


    // Elite TD confidence

    rules.push(

      SpreadsheetApp
        .newConditionalFormatRule()
        .whenNumberGreaterThanOrEqualTo(80)
        .setBackground('#b6d7a8')
        .setRanges([
          confidenceRange
        ])
        .build()
    );


    // Strong

    rules.push(

      SpreadsheetApp
        .newConditionalFormatRule()
        .whenNumberBetween(
          70,
          79.999
        )
        .setBackground('#d9ead3')
        .setRanges([
          confidenceRange
        ])
        .build()
    );


    // Favorable / Watch

    rules.push(

      SpreadsheetApp
        .newConditionalFormatRule()
        .whenNumberBetween(
          60,
          69.999
        )
        .setBackground('#fff2cc')
        .setRanges([
          confidenceRange
        ])
        .build()
    );


    sheet.setConditionalFormatRules(
      rules
    );
  }


  // ==========================================================
  // WIDTHS
  // ==========================================================

  sheet.autoResizeColumns(
    1,
    output[0].length
  );


  sheet.setColumnWidth(
    2,
    180
  );


  sheet.setColumnWidth(
    6,
    150
  );


  sheet.setColumnWidth(
    18,
    170
  );


  sheet.setColumnWidth(
    20,
    500
  );


  sheet
    .getRange('A1')
    .setNote(
      'Best Plays is an anytime-TD screening board. Confidence = 35% WR Usage + 35% TD/RZ Opportunity + 20% Defense vs WR + 10% Coverage, plus small TD-specific bonuses. Betting value will eventually compare this football signal with available sportsbook odds.'
    );


  ss.toast(
    'TD-focused Best Plays board built!',
    'NFL TD Tracker',
    5
  );
}

