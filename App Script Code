      !player ||
      player ===
        'No qualifying play'
    ) {
      continue;
    }


    // ------------------------------------------------------
    // PLAY RANK
    // ------------------------------------------------------

    const playRank =
      numberOrNull_(
        val(
          row,
          'Game Rank'
        )
      );


