// ==========================================================
// SEND DATA TO SUPABASE EDGE FUNCTION
// ==========================================================

function sendNFLResearchToSupabase_(
  dataset,
  rows
) {

  if (!rows || !rows.length) {

    console.log(
      dataset +
      ': no rows to sync.'
    );

    return;
  }


  const props =
    PropertiesService
      .getScriptProperties();


  const supabaseUrl =
    props.getProperty(
      'SUPABASE_URL'
    );


  const anonKey =
    props.getProperty(
      'SUPABASE_ANON_KEY'
    );


  if (!supabaseUrl) {

    throw new Error(
      'SUPABASE_URL is missing from Script Properties.'
    );
  }


  if (!anonKey) {

    throw new Error(
      'SUPABASE_ANON_KEY is missing from Script Properties.'
    );
  }


  const url =
    supabaseUrl +
    '/functions/v1/atd-nfl-research-sync';


  const payload = {

    dataset:
      dataset,

    rows:
      rows
  };


  const response =
    UrlFetchApp.fetch(
      url,
      {
        method: 'post',

        contentType:
          'application/json',

        headers: {

          'apikey':
            anonKey,

          'Authorization':
            'Bearer ' +
            anonKey
        },

        payload:
          JSON.stringify(
            payload
          ),

        muteHttpExceptions:
          true
      }
    );


  const status =
    response.getResponseCode();


  const text =
    response.getContentText();


  console.log(
    dataset +
    ' HTTP ' +
    status
