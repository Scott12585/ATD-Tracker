      'Game Best Plays sheet not found.'
    );
  }

  const data =
    sheet
      .getDataRange()
      .getValues();

  if (data.length < 2) {
    return [];
  }

  const headers =
    data[0].map(
      h => String(h).trim()
    );


  function val(
    row,
    name
  ) {

    const i =
      headers.indexOf(name);

    return i === -1
      ? null
      : row[i];
  }


  const rows = [];


  for (
    let i = 1;
    i < data.length;
    i++
  ) {

    const row =
      data[i];


    // ------------------------------------------------------
    // READ GAME
    // ------------------------------------------------------

    const game =
      String(
        val(
          row,
          'Game'
        ) || ''
      ).trim();


    if (!game) {
      continue;
    }


    // ------------------------------------------------------
    // SKIP "NO QUALIFYING PLAY" ROWS
    // ------------------------------------------------------

    const player =
      String(
        val(
          row,
          'Player'
        ) || ''
      ).trim();


