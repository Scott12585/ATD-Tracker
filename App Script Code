function buildGameBestPlays() {

  const ss = SpreadsheetApp.getActive();

  const bestSheet =
    ss.getSheetByName('Best Plays');

  const scheduleSheet =
    ss.getSheetByName('Schedule');


  if (!bestSheet || !scheduleSheet) {
    throw new Error(
      'Missing Best Plays or Schedule sheet.'
    );
  }


  // ==========================================================
  // SETTINGS
  // ==========================================================

  const MIN_CONFIDENCE = 60;
  const MAX_PLAYS_PER_GAME = 3;


  // ==========================================================
  // READ BEST PLAYS
  // ==========================================================

  const bestData =
    bestSheet
      .getDataRange()
      .getValues();


  if (bestData.length < 2) {
    throw new Error(
      'Best Plays has no player data.'
    );
  }


  const bestHeaders =
    bestData[0].map(
      h => String(h).trim()
    );


  function bestCol(name) {

    const index =
      bestHeaders.indexOf(name);

    if (index === -1) {

      throw new Error(
        'Best Plays column not found: ' +
        name
      );
    }

    return index;
  }


  const B = {

    player:
      bestCol('Player'),

    team:
      bestCol('Team'),

    opponent:
      bestCol('Opponent'),

    location:
      bestCol('H/A'),

    playType:
      bestCol('Play Type'),

    confidence:
      bestCol('Confidence'),

    matchup:
      bestCol('Matchup Score'),

    usage:
      bestCol('WR Usage'),

    tdRZ:
      bestCol('TD/RZ'),

    defense:
      bestCol('Defense'),

    coverage:
      bestCol('Coverage'),

    seasonTD:
      bestCol('Season TD'),

    last3TD:
      bestCol('Last 3 TD'),

    targetsGame:
      bestCol('Targets/Game'),

    targetShare:
      bestCol('Target Share'),

    inside10:
      bestCol('Inside 10'),

    weakestCB:
      bestCol('Weakest CB'),

    cbWeakness:
      bestCol('CB Weakness'),

    reason:
      bestCol('Key Reason')
  };


  // ==========================================================
  // READ SCHEDULE
  // ==========================================================

  const scheduleData =
    scheduleSheet
      .getDataRange()
      .getValues();


  if (scheduleData.length < 2) {
    throw new Error(
      'Schedule has no game data.'
    );
  }


  const scheduleHeaders =
    scheduleData[0].map(
      h => String(h).trim()
    );


  function scheduleCol(name) {

    const index =
      scheduleHeaders.indexOf(name);

    if (index === -1) {

      throw new Error(
        'Schedule column not found: ' +
        name
      );
    }

    return index;
  }


  const S = {

    season:
      scheduleCol('Season'),

    week:
      scheduleCol('Week'),

    date:
      scheduleCol('Date'),

    time:
      scheduleCol('Time ET'),

    away:
      scheduleCol('Away'),

    home:
      scheduleCol('Home'),

    gameId:
      scheduleCol('Game ID'),

    status:
      scheduleCol('Status')
  };


  // ==========================================================
// FIND CURRENT NFL WEEK
// ==========================================================

const currentWeek =
  getCurrentWeek();

Logger.log(
  'Game Best Plays building Week ' +
  currentWeek
);

  // ==========================================================
  // GET THIS WEEK'S GAMES
  // ==========================================================

  const games = [];


  scheduleData
    .slice(1)
    .forEach(row => {

      if (
        Number(row[S.season]) !== 2026 ||
        Number(row[S.week]) !== currentWeek
      ) {
        return;
      }


      const away =
        String(
          row[S.away] || ''
        ).trim();

      const home =
        String(
          row[S.home] || ''
        ).trim();


      if (!away || !home) {
        return;
      }


      games.push({

        week:
          currentWeek,

        date:
          row[S.date],

        time:
          row[S.time],

        away:
          away,

        home:
          home,

        game:
          away + ' @ ' + home,

        gameId:
          row[S.gameId],

        status:
          row[S.status]
      });
    });


  if (!games.length) {

    throw new Error(
      'No schedule games found for Week ' +
      currentWeek +
      '.'
    );
  }


  // ==========================================================
  // TEAM NORMALIZATION
  // ==========================================================

  /*
   * Your Best Plays sheet currently uses abbreviations,
   * so normalize both schedule and Best Plays teams.
   */

  function teamKey(team) {

    const t =
      String(team || '')
        .trim()
        .toUpperCase();


    const map = {

      'ARIZONA CARDINALS': 'ARI',
      'ATLANTA FALCONS': 'ATL',
      'BALTIMORE RAVENS': 'BAL',
      'BUFFALO BILLS': 'BUF',
      'CAROLINA PANTHERS': 'CAR',
      'CHICAGO BEARS': 'CHI',
      'CINCINNATI BENGALS': 'CIN',
      'CLEVELAND BROWNS': 'CLE',
      'DALLAS COWBOYS': 'DAL',
      'DENVER BRONCOS': 'DEN',
      'DETROIT LIONS': 'DET',
      'GREEN BAY PACKERS': 'GB',
      'HOUSTON TEXANS': 'HOU',
      'INDIANAPOLIS COLTS': 'IND',
      'JACKSONVILLE JAGUARS': 'JAX',
      'KANSAS CITY CHIEFS': 'KC',
      'LAS VEGAS RAIDERS': 'LV',
      'LOS ANGELES CHARGERS': 'LAC',
      'LOS ANGELES RAMS': 'LAR',
      'MIAMI DOLPHINS': 'MIA',
      'MINNESOTA VIKINGS': 'MIN',
      'NEW ENGLAND PATRIOTS': 'NE',
      'NEW ORLEANS SAINTS': 'NO',
      'NEW YORK GIANTS': 'NYG',
      'NEW YORK JETS': 'NYJ',
      'PHILADELPHIA EAGLES': 'PHI',
      'PITTSBURGH STEELERS': 'PIT',
      'SAN FRANCISCO 49ERS': 'SF',
      'SEATTLE SEAHAWKS': 'SEA',
      'TAMPA BAY BUCCANEERS': 'TB',
      'TENNESSEE TITANS': 'TEN',
      'WASHINGTON COMMANDERS': 'WAS',

      // Common abbreviation variations

      'JAC': 'JAX',
      'WSH': 'WAS',
      'LA': 'LAR'
    };


    return map[t] || t;
  }


  // ==========================================================
  // BUILD PLAYER OBJECTS
  // ==========================================================

  const players = [];


  for (
    let i = 1;
    i < bestData.length;
    i++
  ) {

    const row =
      bestData[i];


    const player =
      String(
        row[B.player] || ''
      ).trim();


    if (!player) {
      continue;
    }


    const confidence =
      Number(
        row[B.confidence]
      ) || 0;


    if (
      confidence <
      MIN_CONFIDENCE
    ) {
      continue;
    }


    players.push({

      player:
        player,

      team:
        teamKey(
          row[B.team]
        ),

      opponent:
        teamKey(
          row[B.opponent]
        ),

      location:
        row[B.location],

      playType:
        row[B.playType],

      confidence:
        confidence,

      matchup:
        Number(
          row[B.matchup]
        ) || 0,

      usage:
        Number(
          row[B.usage]
        ) || 0,

      tdRZ:
        Number(
          row[B.tdRZ]
        ) || 0,

      defense:
        Number(
          row[B.defense]
        ) || 0,

      coverage:
        Number(
          row[B.coverage]
        ) || 0,

      seasonTD:
        Number(
          row[B.seasonTD]
        ) || 0,

      last3TD:
        Number(
          row[B.last3TD]
        ) || 0,

      targetsGame:
        Number(
          row[B.targetsGame]
        ) || 0,

      targetShare:
        Number(
          row[B.targetShare]
        ) || 0,

      inside10:
        Number(
          row[B.inside10]
        ) || 0,

      weakestCB:
        row[B.weakestCB] || '',

      cbWeakness:
        Number(
          row[B.cbWeakness]
        ) || 0,

      reason:
        row[B.reason] || ''
    });
  }


  // ==========================================================
  // MATCH PLAYERS TO GAMES
  // ==========================================================

  const gameResults = [];


  games.forEach(game => {

    const away =
      teamKey(
        game.away
      );

    const home =
      teamKey(
        game.home
      );


    const candidates =
      players
        .filter(p => {

          return (

            (
              p.team === away &&
              p.opponent === home
            ) ||

            (
              p.team === home &&
              p.opponent === away
            )

          );
        })
        .sort(
          (a, b) => {

            if (
              b.confidence !==
              a.confidence
            ) {

              return (
                b.confidence -
                a.confidence
              );
            }


            if (
              b.matchup !==
              a.matchup
            ) {

              return (
                b.matchup -
                a.matchup
              );
            }


            return (
              b.usage -
              a.usage
            );
          }
        );


    const selected =
      candidates.slice(
        0,
        MAX_PLAYS_PER_GAME
      );


    gameResults.push({

      game:
        game,

      away:
        away,

      home:
        home,

      plays:
        selected
    });
  });


  // ==========================================================
  // OUTPUT
  // ==========================================================

  const output = [[

    'Week',
    'Game',
    'Date',
    'Time ET',

    'Game Rank',

    'Player',
    'Team',
    'Opponent',

    'Play Type',
    'Confidence',

    'Matchup',
    'Usage',
    'TD/RZ',
    'Defense',
    'Coverage',

    'Targets/Game',
    'Target Share',
    'Inside 10',

    'Weakest CB',
    'CB Weakness',

    'Why We Like It'
  ]];


  gameResults.forEach(result => {

    /*
     * IMPORTANT:
     *
     * Games with no qualified plays still get one row.
     * That lets us distinguish:
     *
     * "model found nothing"
     *
     * from
     *
     * "game accidentally disappeared."
     */

    if (!result.plays.length) {

      output.push([

        result.game.week,
        result.away +
          ' @ ' +
          result.home,

        result.game.date,
        result.game.time,

        '',

        'No qualifying play',
        '',
        '',

        '',
        '',

        '',
        '',
        '',
        '',
        '',

        '',
        '',
        '',

        '',
        '',

        'No WR currently meets the model threshold.'

      ]);

      return;
    }


    result.plays.forEach(
      (p, index) => {

        output.push([

          result.game.week,

          result.away +
            ' @ ' +
            result.home,

          result.game.date,
          result.game.time,

          index + 1,

          p.player,
          p.team,
          p.opponent,

          p.playType,
          p.confidence,

          p.matchup,
          p.usage,
          p.tdRZ,
          p.defense,
          p.coverage,

          p.targetsGame,
          p.targetShare,
          p.inside10,

          p.weakestCB,
          p.cbWeakness,

          p.reason
        ]);
      }
    );
  });


  // ==========================================================
  // CREATE / CLEAR SHEET
  // ==========================================================

  let sheet =
    ss.getSheetByName(
      'Game Best Plays'
    );


  if (!sheet) {

    sheet =
      ss.insertSheet(
        'Game Best Plays'
      );
  }


  sheet.clear();


  /*
   * Make sure the sheet is large enough.
   *
   * This avoids depending on another helper function.
   */

  const neededRows =
    output.length;

  const neededCols =
    output[0].length;


  if (
    sheet.getMaxRows() <
    neededRows
  ) {

    sheet.insertRowsAfter(
      sheet.getMaxRows(),
      neededRows -
        sheet.getMaxRows()
    );
  }


  if (
    sheet.getMaxColumns() <
    neededCols
  ) {

    sheet.insertColumnsAfter(
      sheet.getMaxColumns(),
      neededCols -
        sheet.getMaxColumns()
    );
  }


  sheet
    .getRange(
      1,
      1,
      output.length,
      output[0].length
    )
    .setValues(output);


  // ==========================================================
  // HEADER FORMAT
  // ==========================================================

  sheet
    .getRange(
      1,
      1,
      1,
      output[0].length
    )
    .setBackground(
      '#0d293f'
    )
    .setFontColor(
      '#ffffff'
    )
    .setFontWeight(
      'bold'
    )
    .setWrap(
      true
    );


  sheet.setFrozenRows(1);


  // ==========================================================
  // NUMBER FORMATTING
  // ==========================================================

  // Format Date and Time columns
if (output.length > 1) {

  sheet
    .getRange(
      2,
      3,
      output.length - 1,
      1
    )
    .setNumberFormat('m/d/yyyy');

  sheet
    .getRange(
      2,
      4,
      output.length - 1,
      1
    )
    .setNumberFormat('h:mm AM/PM');
}


  if (output.length > 1) {

    const rows =
      output.length - 1;


    // Confidence through Coverage

    sheet
      .getRange(
        2,
        10,
        rows,
        6
      )
      .setNumberFormat(
        '0'
      );


    // Targets/Game

    sheet
      .getRange(
        2,
        16,
        rows,
        1
      )
      .setNumberFormat(
        '0.0'
      );


    // Target Share

    sheet
      .getRange(
        2,
        17,
        rows,
        1
      )
      .setNumberFormat(
        '0.0%'
      );


    // Inside 10

    sheet
      .getRange(
        2,
        18,
        rows,
        1
      )
      .setNumberFormat(
        '0'
      );


    // CB weakness

    sheet
      .getRange(
        2,
        20,
        rows,
        1
      )
      .setNumberFormat(
        '0'
      );
  }


  // ==========================================================
  // CONDITIONAL FORMATTING
  // ==========================================================

  if (output.length > 1) {

    const rows =
      output.length - 1;


    const confidenceRange =
      sheet.getRange(
        2,
        10,
        rows,
        1
      );


    const rules = [];


    // Elite

    rules.push(

      SpreadsheetApp
        .newConditionalFormatRule()
        .whenNumberGreaterThanOrEqualTo(
          85
        )
        .setBackground(
          '#b6d7a8'
        )
        .setRanges([
          confidenceRange
        ])
        .build()

    );


    // Strong

    rules.push(

      SpreadsheetApp
        .newConditionalFormatRule()
        .whenNumberBetween(
          75,
          84.999
        )
        .setBackground(
          '#d9ead3'
        )
        .setRanges([
          confidenceRange
        ])
        .build()

    );


    // Watch

    rules.push(

      SpreadsheetApp
        .newConditionalFormatRule()
        .whenNumberBetween(
          65,
          74.999
        )
        .setBackground(
          '#fff2cc'
        )
        .setRanges([
          confidenceRange
        ])
        .build()

    );


    sheet.setConditionalFormatRules(
      rules
    );
  }


  // ==========================================================
  // VISUAL SEPARATION BETWEEN GAMES
  // ==========================================================

  if (output.length > 2) {

    let previousGame = '';


    for (
      let r = 2;
      r <= output.length;
      r++
    ) {

      const game =
        String(
          sheet
            .getRange(
              r,
              2
            )
            .getValue()
        );


      if (
        previousGame &&
        game !== previousGame
      ) {

        sheet
          .getRange(
            r,
            1,
            1,
            output[0].length
          )
          .setBorder(
            true,
            null,
            null,
            null,
            null,
            null,
            '#666666',
            SpreadsheetApp.BorderStyle.SOLID_MEDIUM
          );
      }


      previousGame =
        game;
    }
  }


  // ==========================================================
  // COLUMN WIDTHS
  // ==========================================================

  sheet.autoResizeColumns(
    1,
    output[0].length
  );


  sheet.setColumnWidth(
    2,
    120
  );


  sheet.setColumnWidth(
    6,
    180
  );


  sheet.setColumnWidth(
    9,
    150
  );


  sheet.setColumnWidth(
    19,
    170
  );


  sheet.setColumnWidth(
    21,
    500
  );


  // Wrap explanation column

  if (output.length > 1) {

    sheet
      .getRange(
        2,
        21,
        output.length - 1,
        1
      )
      .setWrap(true);
  }


  // ==========================================================
  // FILTER
  // ==========================================================

  const existingFilter =
    sheet.getFilter();


  if (existingFilter) {
    existingFilter.remove();
  }


  sheet
    .getRange(
      1,
      1,
      output.length,
      output[0].length
    )
    .createFilter();


  // ==========================================================
  // NOTE
  // ==========================================================

  sheet
    .getRange('A1')
    .setNote(
      'Game Best Plays shows up to 3 qualifying WR touchdown candidates per game. Players must first qualify for Best Plays and have Confidence >= ' +
      MIN_CONFIDENCE +
      '. Games with no qualifying candidate remain visible.'
    );


  ss.toast(
    'Week ' +
      currentWeek +
      ' Game Best Plays built!',
    'NFL TD Tracker',
    6
  );
}

